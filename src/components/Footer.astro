<footer class="footer" role="contentinfo">
  <div class="container">
    <div class="footer-inner">
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="hierarchical-approval home">
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <rect width="20" height="20" rx="5" fill="#1a7a45"/>
            <path d="M5 10.5l3.5 3.5L15 6.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>hierarchical-approval</span>
        </a>
        <p class="footer-desc">TypeScript-first approval workflow engine for ERP systems. MIT license.</p>
        <p class="footer-author">
          Built by <a href="https://www.matthewswong.com" target="_blank" rel="noopener noreferrer">Matthews Wong</a>
        </p>
      </div>

      <nav class="footer-links" aria-label="Footer navigation">
        <div class="footer-col">
          <div class="footer-col-title">Library</div>
          <a href="https://www.npmjs.com/package/hierarchical-approval" target="_blank" rel="noopener noreferrer">npm package</a>
          <a href="https://github.com/matthews-wong/hierarchical-approval" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href="/llms.txt">llms.txt</a>
          <a href="/sitemap-index.xml">Sitemap</a>
        </div>
        <div class="footer-col">
          <div class="footer-col-title">On this page</div>
          <a href="#why">Why this library</a>
          <a href="#how-it-works">How it works</a>
          <a href="#features">Features</a>
          <a href="#adapters">Adapters</a>
          <a href="#comparison">Comparison</a>
          <a href="#blog">Blog</a>
        </div>
        <div class="footer-col">
          <div class="footer-col-title">Blog</div>
          <a href="https://www.matthewswong.com/en/blog/hierarchical-approval-npm-library" target="_blank" rel="noopener noreferrer">Library deep-dive</a>
          <a href="https://www.matthewswong.com/en/blog/accounts-payable-multi-approval-nestjs" target="_blank" rel="noopener noreferrer">AP in NestJS</a>
          <a href="https://www.matthewswong.com/en/blog/erp-hr-leave-approval-flow" target="_blank" rel="noopener noreferrer">HR leave flow</a>
          <a href="https://www.matthewswong.com/en/blog/erp-approval-matrix-configuration" target="_blank" rel="noopener noreferrer">Approval matrix</a>
        </div>
      </nav>
    </div>

    <div class="footer-bottom">
      <span>© <span class="footer-year"></span> Matthews Wong — MIT License</span>
      <span class="footer-version">v0.1.1</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border-light);
    padding-block: 3.5rem 2rem;
    background: var(--bg-alt);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    max-width: 280px;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
  }

  .footer-logo:hover { color: var(--accent); text-decoration: none; }

  .footer-desc {
    font-size: 0.8125rem;
    color: var(--text-2);
    line-height: 1.55;
  }

  .footer-author {
    font-size: 0.8rem;
    color: var(--text-3);
  }

  .footer-author a { color: var(--accent); }

  .footer-links {
    display: flex;
    gap: 2.5rem;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-col-title {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
    margin-bottom: 0.25rem;
  }

  .footer-col a {
    font-size: 0.8375rem;
    color: var(--text-2);
    text-decoration: none;
    transition: color 0.15s;
  }

  .footer-col a:hover { color: var(--text); text-decoration: none; }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-light);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-3);
  }

  .footer-version {
    background: white;
    border: 1px solid var(--border-light);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    color: var(--text-3);
  }

  @media (max-width: 768px) {
    .footer-inner { grid-template-columns: 1fr; }
    .footer-links { flex-wrap: wrap; gap: 2rem; }
  }

  @media (max-width: 480px) {
    .footer-links { flex-direction: column; gap: 1.5rem; }
    .footer-col { flex-direction: row; flex-wrap: wrap; gap: 0.375rem 1.25rem; }
    .footer-col-title { width: 100%; margin-bottom: 0.125rem; }
  }
</style>

<script>
  const el = document.querySelector('.footer-year');
  if (el) el.textContent = String(new Date().getFullYear());
</script>
