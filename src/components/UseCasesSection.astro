---
const cases = [
  {
    tag: 'finance',
    title: 'Amount-Based AP Approval',
    desc: 'Auto-build 1–4 level chains from invoice amount. Under $1k needs one approver; over $50k routes to the board.',
    edge: 'Concurrent race condition when two approvers submit simultaneously',
    href: '/use-cases/accounts-payable/',
    iconColor: '#1d6fe4',
    iconBg: '#eff6ff',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>`,
  },
  {
    tag: 'hr',
    title: 'Leave Request Workflows',
    desc: 'Different chains per leave type. Annual leave needs manager + HR. Emergency leave auto-approves with post-hoc notification.',
    edge: 'Manager is themselves on leave — auto-delegates to department head',
    href: '/use-cases/hr-leave/',
    iconColor: '#7c3aed',
    iconBg: '#f5f3ff',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>`,
  },
  {
    tag: 'procurement',
    title: 'Multi-Department PO Routing',
    desc: 'IT, Operations, and Marketing procurement follow different chain templates. Amount thresholds add Finance sign-off.',
    edge: 'Split PO detected and flagged before submission',
    href: '/use-cases/purchase-orders/',
    iconColor: '#b45309',
    iconBg: '#fef9ee',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>`,
  },
  {
    tag: 'finance',
    title: 'Employee Expense Reimbursement',
    desc: 'Auto-approve small expenses; escalate large ones to Finance and CFO. International expenses always get Compliance review.',
    edge: 'Duplicate expense detection across linked submissions',
    href: '/use-cases/expense-reports/',
    iconColor: '#0891b2',
    iconBg: '#ecfeff',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>`,
  },
  {
    tag: 'legal',
    title: 'Contract Approval Pipeline',
    desc: 'Legal review before every contract. High-value or board-required contracts add extra levels. Amendments restart the chain.',
    edge: 'Counter-signature required from external party',
    href: '/use-cases/contract-signing/',
    iconColor: '#1a7a45',
    iconBg: '#f0f9f4',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>`,
  },
  {
    tag: 'saas',
    title: 'Per-Tenant Approval Rules',
    desc: 'Each tenant configures their own approval chain in your admin UI. Basic plan gets one approver; Enterprise gets custom chains.',
    edge: 'Tenant suspended mid-approval — orphan instances handled',
    href: '/use-cases/multi-tenant-saas/',
    iconColor: '#dc2626',
    iconBg: '#fef2f2',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>`,
  },
];
---

<section class="section use-cases" id="use-cases" aria-labelledby="uc-title">
  <div class="container">
    <span class="section-label">Real-world scenarios</span>
    <h2 class="section-title" id="uc-title">From idea to production in hours.</h2>
    <p class="section-sub">
      Every use case ships with complete TypeScript code and handles the edge cases you'll actually hit.
    </p>

    <div class="uc-grid">
      {cases.map((c) => (
        <a href={c.href} class="uc-card" aria-label={c.title}>
          <div class="uc-icon" style={`background:${c.iconBg};color:${c.iconColor}`}>
            <Fragment set:html={c.icon} />
          </div>
          <div class="uc-tag">{c.tag}</div>
          <h3 class="uc-title">{c.title}</h3>
          <p class="uc-desc">{c.desc}</p>
          <p class="uc-edge"><span class="edge-label">Handles:</span> {c.edge}</p>
          <span class="uc-cta">
            Explore
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </span>
        </a>
      ))}
    </div>

    <div class="uc-footer">
      <a href="/use-cases/" class="uc-all-link">View all use cases with full code examples</a>
    </div>
  </div>
</section>

<style>
  .use-cases {
    background: var(--bg);
    border-top: 1px solid var(--border-light);
  }

  .section-sub { margin-bottom: 3rem; }

  .uc-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .uc-card {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1.5rem;
    background: white;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
    text-decoration: none;
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .uc-card:hover {
    box-shadow: var(--shadow);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .uc-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-bottom: 0.25rem;
  }

  .uc-tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .uc-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.01em;
    line-height: 1.35;
  }

  .uc-desc {
    font-size: 0.8125rem;
    color: var(--text-2);
    line-height: 1.6;
    flex: 1;
  }

  .uc-edge {
    font-size: 0.75rem;
    color: var(--text-3);
    line-height: 1.5;
    padding-top: 0.375rem;
    border-top: 1px solid var(--border-light);
  }

  .edge-label {
    color: var(--accent);
    font-weight: 600;
  }

  .uc-cta {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--accent);
    margin-top: 0.25rem;
  }

  .uc-footer {
    text-align: center;
    margin-top: 2rem;
  }

  .uc-all-link {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-2);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1px;
    transition: color 0.15s, border-color 0.15s;
  }

  .uc-all-link:hover { color: var(--text); border-color: var(--text); text-decoration: none; }

  @media (max-width: 860px) { .uc-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .uc-grid { grid-template-columns: 1fr; } }
</style>
