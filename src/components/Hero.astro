<script>
  fetch('https://api.npmjs.org/downloads/point/last-week/hierarchical-approval')
    .then(r => r.json())
    .then(data => {
      if (typeof data.downloads === 'number') {
        const el = document.getElementById('weekly-downloads');
        if (el) el.textContent = data.downloads.toLocaleString('en-US') + ' downloads / week';
      }
    })
    .catch(() => {});
</script>
