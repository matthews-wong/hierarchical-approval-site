---
const posts = [
  {
    title: 'Multi-Level Approval Workflows in Node.js — Without BPMN',
    excerpt:
      'A hands-on guide: templates, conditional levels, delegation, the audit trail, and a NestJS integration — build a purchase-order approval chain step by step.',
    href: '/guide/multi-level-approval-workflows-in-node',
    tag: 'Guide · Node.js',
    readTime: '10 min',
    internal: true,
  },
  {
    title: 'I Built an npm Library for ERP Hierarchical Approval Workflows',
    excerpt: 'The story behind this library: why existing solutions fell short, how optimistic locking and idempotency work under the hood, and how to test time-dependent logic without real timers.',
    href: 'https://www.matthewswong.com/en/blog/hierarchical-approval-npm-library',
    tag: 'Library deep-dive',
    readTime: '12 min',
  },
  {
    title: 'Accounts Payable Multi-Level Approval Workflow in NestJS',
    excerpt: 'Configurable amount-based AP approval chains with PostgreSQL: schema design, the chain-building algorithm, and sequential processing logic.',
    href: 'https://www.matthewswong.com/en/blog/accounts-payable-multi-approval-nestjs',
    tag: 'NestJS · PostgreSQL',
    readTime: '9 min',
  },
  {
    title: 'ERP HR Leave Approval Flow',
    excerpt: 'Department-based leave approval with delegation and escalation patterns in an ERP context — when and how to hand off without breaking the audit trail.',
    href: 'https://www.matthewswong.com/en/blog/erp-hr-leave-approval-flow',
    tag: 'HR systems · ERP',
    readTime: '7 min',
  },
  {
    title: 'ERP Approval Matrix Configuration',
    excerpt: 'Designing a configurable approval matrix that non-engineers can maintain without a code deployment. How to map business rules to a data model your ops team can update.',
    href: 'https://www.matthewswong.com/en/blog/erp-approval-matrix-configuration',
    tag: 'Configuration · ERP',
    readTime: '8 min',
  },
];
---

<section class="section blog" id="blog" aria-labelledby="blog-title">
  <div class="container">
    <span class="section-label">From the author</span>
    <h2 class="section-title" id="blog-title">The thinking behind the library.</h2>
    <p class="section-sub">
      Real-world ERP approval patterns — the decisions, tradeoffs, and edge cases that shaped every feature.
    </p>

    <div class="blog-grid">
      {posts.map((p) => (
        <a
          href={p.href}
          class="blog-card"
          target={p.internal ? undefined : '_blank'}
          rel={p.internal ? undefined : 'noopener noreferrer'}
          aria-label={`Read: ${p.title}`}
        >
          <div class="blog-meta">
            <div class="blog-tag">{p.tag}</div>
            <div class="blog-time">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              </svg>
              {p.readTime} read
            </div>
          </div>
          <h3 class="blog-title">{p.title}</h3>
          <p class="blog-excerpt">{p.excerpt}</p>
          <div class="blog-cta">
            {p.internal ? 'Read the guide' : 'Read on matthewswong.com'}
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/>
              <line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .blog {
    background: var(--bg-alt);
    border-top: 1px solid var(--border-light);
  }

  .section-sub { margin-bottom: 3rem; }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }

  .blog-card {
    background: white;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    text-decoration: none;
    box-shadow: var(--shadow-xs);
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .blog-card:hover {
    box-shadow: var(--shadow);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .blog-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .blog-tag {
    font-size: 0.7rem;
    font-weight: 600;
    font-family: var(--font-mono);
    color: var(--accent);
    background: var(--accent-bg);
    border: 1px solid var(--accent-mid);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    letter-spacing: 0.03em;
  }

  .blog-time {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.7rem;
    color: var(--text-3);
    white-space: nowrap;
    font-family: var(--font-mono);
  }

  .blog-title {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  .blog-excerpt {
    font-size: 0.8375rem;
    color: var(--text-2);
    line-height: 1.6;
    flex: 1;
  }

  .blog-cta {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--accent);
    margin-top: 0.25rem;
  }
</style>
