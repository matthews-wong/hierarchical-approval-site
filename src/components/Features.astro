---
const features = [
  {
    icon: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>`,
    title: 'Optimistic locking',
    desc: 'Every instance carries a version counter. Concurrent approvals detect conflicts and throw CONFLICT — the caller re-fetches and retries.',
    color: '#1d6fe4', colorBg: '#eff6ff',
  },
  {
    icon: `<path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>`,
    title: 'Idempotency',
    desc: 'Submitting the same document twice returns the existing in-flight instance. Keyed by SHA-256 of tenant + docType + docId + template.',
    color: '#7c3aed', colorBg: '#f5f3ff',
  },
  {
    icon: `<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>`,
    title: 'Immutable audit trail',
    desc: 'Every mutation appends an AuditEntry with actor, timestamp, old and new values, and comment. Nothing is ever overwritten.',
    color: '#b45309', colorBg: '#fef9ee',
  },
  {
    icon: `<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>`,
    title: 'SLA tracking',
    desc: 'Set slaDeadlineDays on a template. The engine computes the deadline at submit time and fires approval:sla_breached automatically.',
    color: '#0891b2', colorBg: '#ecfeff',
  },
  {
    icon: `<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>`,
    title: 'Conditional chains',
    desc: 'Levels activate or skip based on document data. Use built-in operators (>, <, in, not_in) or register custom ones per-engine instance.',
    color: '#1a7a45', colorBg: '#f0f9f4',
  },
  {
    icon: `<rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>`,
    title: 'Bulk operations',
    desc: 'bulkApprove() and bulkReject() process up to 200 instances per call. Individual failures are collected — the batch never aborts on a single error.',
    color: '#dc2626', colorBg: '#fef2f2',
  },
  {
    icon: `<path d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>`,
    title: 'ApprovalTestKit',
    desc: 'ApprovalTestKit.create() returns {engine, adapter, clock} pre-wired. ManualClock.advanceDays(n) tests SLA and escalation without real timers.',
    color: '#4338ca', colorBg: '#eef2ff',
  },
  {
    icon: `<circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/>`,
    title: 'Six pluggable adapters',
    desc: 'Notification, Audit, Metrics, Scheduler, Authorization, Middleware — each a typed interface. Notification and audit failures are logged and swallowed; an authorization policy can deny an operation.',
    color: '#c2410c', colorBg: '#fff7ed',
  },
];
---

<section class="section features" id="features" aria-labelledby="feat-title">
  <div class="container">
    <span class="section-label">Capabilities</span>
    <h2 class="section-title" id="feat-title">Everything ERP approval logic demands.</h2>
    <p class="section-sub">
      The hard problems are solved at the library level so you write business rules, not infrastructure.
    </p>

    <div class="feat-grid">
      {features.map((f) => (
        <div class="feat-card">
          <div class="feat-icon" aria-hidden="true" style={`background:${f.colorBg};color:${f.color}`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <Fragment set:html={f.icon} />
            </svg>
          </div>
          <h3 class="feat-title">{f.title}</h3>
          <p class="feat-desc">{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features {
    background: var(--bg-alt);
    border-top: 1px solid var(--border-light);
  }

  .section-sub { margin-bottom: 3rem; }

  .feat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1px;
    background: var(--border-light);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .feat-card {
    background: white;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: background 0.15s;
  }

  .feat-card:hover { background: #fafffe; }

  .feat-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.5rem;
    flex-shrink: 0;
  }

  .feat-title {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .feat-desc {
    font-size: 0.85rem;
    color: var(--text-2);
    line-height: 1.6;
  }
</style>
