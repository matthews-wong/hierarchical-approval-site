<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--border-light);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 52px;
    gap: 1.5rem;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
    flex-shrink: 0;
  }

  .nav-logo:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .nav-menu {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    color: var(--text-2);
    text-decoration: none;
    padding: 0.375rem 0.625rem;
    border-radius: 6px;
    transition: color 0.15s, background 0.15s;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: var(--text);
    background: var(--bg-alt);
    text-decoration: none;
  }

  .nav-cta {
    font-size: 0.875rem;
    font-weight: 500;
    color: white;
    background: var(--text);
    padding: 0.4375rem 0.875rem;
    border-radius: 980px;
    text-decoration: none;
    transition: opacity 0.15s;
    white-space: nowrap;
  }

  .nav-cta:hover {
    opacity: 0.8;
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .nav-menu .nav-link:not(:last-child) { display: none; }
  }

  @media (max-width: 400px) {
    .nav-menu,
    .nav-actions .nav-link { display: none; }
    .nav-inner { gap: 0.75rem; }
    .nav-logo { font-size: 0.75rem; }
    .nav-cta { font-size: 0.8125rem; padding: 0.4375rem 0.75rem; }
  }

  @media (max-width: 640px) {
    .nav-menu,
    .nav-actions .nav-link { display: none; }
    .nav-link:not(.nav-cta) { display: none; }
  }
</style>
