---
import UseCaseLayout from '../../layouts/UseCaseLayout.astro';
import { hl } from '../../lib/highlight';

const configCode = hl(`import { ApprovalEngine } from 'hierarchical-approval';
import { PostgresAdapter } from 'hierarchical-approval/adapters/postgres';

const engine = new ApprovalEngine({
  adapter: new PostgresAdapter({ connectionString: process.env.DATABASE_URL }),
  tenantId: 'acme-corp',
  // Resolves every { type: 'role' } approver below
  orgProvider: { getUsersByRole: (role) => directory.usersWithRole(role) },
});

// Conditions read plain data fields, so convert to USD before submitting
// and store the result as data.amountUsd (see edge case 03).
await engine.defineTemplate({
  name: 'expense-report',
  documentType: 'expense',
  levels: [
    {
      level: 1,
      name: 'Direct manager',
      approvers: [{ type: 'role', role: 'direct-manager' }],
      mode: 'any',
    },
  ],
  conditions: [
    {
      when: { field: 'amountUsd', operator: '>', value: 500 },
      addLevels: [
        {
          level: 2,
          name: 'Finance',
          approvers: [{ type: 'role', role: 'finance-controller' }],
          mode: 'any',
        },
      ],
    },
    {
      when: { field: 'amountUsd', operator: '>', value: 2_000 },
      addLevels: [
        {
          level: 3,
          name: 'CFO',
          approvers: [{ type: 'role', role: 'cfo' }],
          mode: 'any',
        },
      ],
    },
    {
      when: { field: 'isInternational', operator: '==', value: true },
      addLevels: [
        {
          level: 4,
          name: 'Compliance',
          approvers: [{ type: 'role', role: 'compliance-officer' }],
          mode: 'any',
        },
      ],
    },
  ],
});`);

const dupeCode = hl(`// Detect duplicate expense reports before submitting
const DUPLICATE_WINDOW_MS = 7 * 24 * 60 * 60 * 1000;

async function isDuplicate(
  employeeId: string,
  category: string,
  totalAmount: number,
  currency: string
): Promise<boolean> {
  const recent = await engine.queryInstances({
    documentType: 'expense',
    submittedBy: employeeId,
    fromDate: new Date(Date.now() - DUPLICATE_WINDOW_MS),
    // Matches instances whose data contains all of these pairs
    data: { category, totalAmount, currency },
  });
  return recent.items.some((instance) => instance.status !== 'rejected');
}

if (await isDuplicate(employeeId, category, amount, currency)) {
  throw new Error('Duplicate expense report detected within the last 7 days');
}`);

const receiptCode = hl(`// Hold approval until receipts are attached (IAuthorizationPolicy)
import { ApprovalEngine } from 'hierarchical-approval';
import type { IAuthorizationPolicy, AuthorizationContext } from 'hierarchical-approval';

const MEAL_RECEIPT_THRESHOLD_USD = 25;

class ReceiptPolicy implements IAuthorizationPolicy {
  authorize(ctx: AuthorizationContext): string | undefined {
    if (ctx.operation !== 'approve') return undefined;

    const { receipts, category, amountUsd } = ctx.instance.data as {
      receipts: string[];
      category: string;
      amountUsd: number;
    };
    const requiresReceipt =
      category !== 'meals' || amountUsd > MEAL_RECEIPT_THRESHOLD_USD;

    if (requiresReceipt && receipts.length === 0) {
      return 'Receipt required for this expense category and amount';
    }
    return undefined; // allow
  }
}

const engine = new ApprovalEngine({
  adapter: new PostgresAdapter({ connectionString: process.env.DATABASE_URL }),
  tenantId: 'acme-corp',
  authorizationPolicy: new ReceiptPolicy(),
});

// approve() now throws ApprovalForbiddenError until the employee attaches them:
await engine.updateData(instance.id, {
  updatedBy: 'emp-4821',
  data: { receipts: ['receipt-001.pdf'] },
});`);
---

<UseCaseLayout
  title="Employee Expense Reimbursement"
  description="Auto-approve small expenses after manager sign-off. Large or international expenses get Finance and Compliance review. Duplicate detection before submit and a receipt check before anyone can approve."
  tag="Finance & HR"
>
  <section class="uc-hero">
    <div class="container">
      <div class="uc-tag-row">
        <span class="uc-tag" style="color:#0891b2">Finance &amp; HR</span>
        <span class="uc-badge">expense-report</span>
      </div>
      <h1 class="uc-title">Employee Expense Reimbursement</h1>
      <p class="uc-sub">
        Small expenses route through manager only. Large ones escalate to Finance and CFO.
        International expenses always get Compliance review. The USD amount is computed once, when you submit,
        so later FX movements don't change who has to approve.
      </p>
    </div>
  </section>

  <section class="chain-section">
    <div class="container">
      <div class="section-label-sm">Approval chain by amount</div>
      <div class="chains-table">
        <div class="chain-row">
          <span class="chain-type">Under $500</span>
          <div class="chain-flow">
            <div class="cf-node cf-always"><span class="cf-name">Manager</span></div>
            <span class="cf-arrow">→</span>
            <div class="cf-node cf-done"><span class="cf-name">Approved</span></div>
          </div>
        </div>
        <div class="chain-row">
          <span class="chain-type">$500 – $2,000</span>
          <div class="chain-flow">
            <div class="cf-node cf-always"><span class="cf-name">Manager</span></div>
            <span class="cf-arrow">→</span>
            <div class="cf-node cf-cond"><span class="cf-name">Finance</span></div>
            <span class="cf-arrow">→</span>
            <div class="cf-node cf-done"><span class="cf-name">Approved</span></div>
          </div>
        </div>
        <div class="chain-row">
          <span class="chain-type">Over $2,000</span>
          <div class="chain-flow">
            <div class="cf-node cf-always"><span class="cf-name">Manager</span></div>
            <span class="cf-arrow">→</span>
            <div class="cf-node cf-cond"><span class="cf-name">Finance</span></div>
            <span class="cf-arrow">→</span>
            <div class="cf-node cf-cond"><span class="cf-name">CFO</span></div>
            <span class="cf-arrow">→</span>
            <div class="cf-node cf-done"><span class="cf-name">Approved</span></div>
          </div>
        </div>
        <div class="chain-row">
          <span class="chain-type">International (any)</span>
          <div class="chain-flow">
            <div class="cf-node cf-always"><span class="cf-name">Manager</span></div>
            <span class="cf-arrow">→</span>
            <div class="cf-node cf-cond"><span class="cf-name">Finance</span><span class="cf-badge-sm">if &gt;$500</span></div>
            <span class="cf-arrow">→</span>
            <div class="cf-node cf-always" style="border-color:#0891b2;background:#ecfeff"><span class="cf-name">Compliance</span></div>
            <span class="cf-arrow">→</span>
            <div class="cf-node cf-done"><span class="cf-name">Approved</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="code-section">
    <div class="container code-grid">
      <div class="code-meta">
        <span class="section-label-sm">Configuration</span>
        <h2 class="code-heading">Amount-tiered chain with FX lock</h2>
        <p class="code-desc">
          Template conditions compare plain data fields, so your code converts the amount to USD
          <em>before submitting</em> and stores it as <code>amountUsd</code> next to the original
          currency and amount. Approvers see the original; thresholds use the stored USD value.
        </p>
        <ul class="code-bullets">
          <li>FX rate applied once by your code, before submit</li>
          <li>The international flag adds Compliance as the last level</li>
          <li>CFO level only activates above $2k</li>
          <li>Meals up to $25 skip the receipt requirement in the policy below</li>
        </ul>
      </div>
      <div class="code-block">
        <div class="code-header">
          <span class="code-dots"><span></span><span></span><span></span></span>
          <span class="code-filename">expense-template.ts</span>
        </div>
        <pre class="code-pre"><code><Fragment set:html={configCode} /></code></pre>
      </div>
    </div>
  </section>

  <section class="edges-section">
    <div class="container">
      <span class="section-label">Edge cases</span>
      <h2 class="section-title">Three ways expense workflows break in production.</h2>
      <p class="section-sub">Common failure modes in expense systems that <code>hierarchical-approval</code> prevents.</p>

      <div class="edges-grid">
        <div class="edge-card">
          <div class="edge-num">01</div>
          <h3 class="edge-title">Duplicate expense detection</h3>
          <p class="edge-desc">
            An employee accidentally submits the same expense twice — same category,
            amount, and currency within days of each other. Both get approved,
            finance pays twice.
          </p>
          <div class="code-block">
            <div class="code-header">
              <span class="code-dots"><span></span><span></span><span></span></span>
              <span class="code-filename">duplicate-check.ts</span>
            </div>
            <pre class="code-pre"><code><Fragment set:html={dupeCode} /></code></pre>
          </div>
          <p class="edge-note">
            Check before <code>engine.submit()</code>. <code>queryInstances</code> matches the
            stored <code>data</code> fields exactly, so the 7-day window is the only fuzziness.
          </p>
        </div>

        <div class="edge-card">
          <div class="edge-num">02</div>
          <h3 class="edge-title">Receipt validation at the boundary</h3>
          <p class="edge-desc">
            An employee submits a $500 equipment expense with no receipts attached.
            Finance approves it anyway — because nothing in the workflow stops them.
          </p>
          <div class="code-block">
            <div class="code-header">
              <span class="code-dots"><span></span><span></span><span></span></span>
              <span class="code-filename">receipt-policy.ts</span>
            </div>
            <pre class="code-pre"><code><Fragment set:html={receiptCode} /></code></pre>
          </div>
          <p class="edge-note">
            <code>IAuthorizationPolicy</code> denies <code>approve</code> while the receipts
            array is empty for categories that require them. The engine throws <code>ApprovalForbiddenError</code>,
            so the rule holds whatever the UI does. The policy is not consulted on <code>submit</code>.
          </p>
        </div>

        <div class="edge-card">
          <div class="edge-num">03</div>
          <h3 class="edge-title">Foreign currency amount drift</h3>
          <p class="edge-desc">
            An employee submits a €1,800 expense (below the $2k CFO threshold at today's rate).
            By the time Finance approves it two weeks later, the rate has moved — the expense
            is now over the threshold.
          </p>
          <div class="edge-solution">
            <div class="solution-step">
              <span class="step-num">1</span>
              <span>Before <code>engine.submit()</code>, call <code>fx.convert()</code> and put both the original and the USD amount in <code>data</code></span>
            </div>
            <div class="solution-step">
              <span class="step-num">2</span>
              <span>The template's conditions read <code>data.amountUsd</code>, never a live rate</span>
            </div>
            <div class="solution-step">
              <span class="step-num">3</span>
              <span>Finance approves what was submitted — no surprises from currency movement</span>
            </div>
          </div>
          <p class="edge-note">
            The levels are decided when you submit. They only change if you call
            <code>engine.updateData()</code> with new values, which re-evaluates the conditions.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="related-section">
    <div class="container">
      <h2 class="related-title">Related use cases</h2>
      <div class="related-grid">
        <a href="/use-cases/accounts-payable/" class="related-card">
          <span class="related-tag">Finance & ERP</span>
          <span class="related-name">Accounts Payable →</span>
        </a>
        <a href="/use-cases/hr-leave/" class="related-card">
          <span class="related-tag">HR Systems</span>
          <span class="related-name">HR Leave Requests →</span>
        </a>
        <a href="/use-cases/purchase-orders/" class="related-card">
          <span class="related-tag">Procurement</span>
          <span class="related-name">Purchase Orders →</span>
        </a>
      </div>
    </div>
  </section>
</UseCaseLayout>

<style>
  .uc-hero { padding-block: 3.5rem 2.5rem; background: var(--bg); border-bottom: 1px solid var(--border-light); }
  .uc-tag-row { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.25rem; }
  .uc-tag { font-family: var(--font-mono); font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; }
  .uc-badge { font-family: var(--font-mono); font-size: 0.7rem; background: var(--bg-alt); border: 1px solid var(--border-light); color: var(--text-3); padding: 0.175rem 0.5rem; border-radius: 4px; }
  .uc-title { font-size: clamp(1.75rem, 3.5vw, 2.75rem); font-weight: 700; letter-spacing: -0.03em; margin-bottom: 1rem; }
  .uc-sub { font-size: 1.0625rem; color: var(--text-2); line-height: 1.65; max-width: 58ch; }

  .chain-section { padding-block: 2.5rem; background: var(--bg-alt); border-bottom: 1px solid var(--border-light); }
  .section-label-sm { font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); display: block; margin-bottom: 1.25rem; }
  .chains-table { display: flex; flex-direction: column; gap: 0.625rem; }
  .chain-row { display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap; }
  .chain-type { font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-3); min-width: 120px; }
  .chain-flow { display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap; }
  .cf-node { display: flex; flex-direction: column; align-items: center; gap: 0.2rem; padding: 0.5rem 0.75rem; border-radius: var(--radius); border: 1.5px solid var(--border); background: white; min-width: 72px; }
  .cf-always { border-color: var(--accent); background: var(--accent-bg); }
  .cf-cond   { border-color: var(--border-light); }
  .cf-done   { border-color: var(--accent); background: #d1fae5; }
  .cf-name { font-size: 0.75rem; font-weight: 600; color: var(--text); }
  .cf-badge-sm { font-family: var(--font-mono); font-size: 0.5rem; color: var(--text-3); }
  .cf-arrow { color: var(--border); font-size: 1.25rem; }

  .code-section { padding-block: 4rem; background: var(--bg); border-top: 1px solid var(--border-light); }
  .code-grid { display: grid; grid-template-columns: 280px 1fr; gap: 3rem; align-items: start; }
  .code-heading { font-size: 1.375rem; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 0.75rem; margin-top: 0.5rem; }
  .code-desc { font-size: 0.875rem; color: var(--text-2); line-height: 1.65; margin-bottom: 1rem; }
  .code-desc em { font-style: italic; }
  .code-desc code, .edge-note code, .solution-step code { font-family: var(--font-mono); font-size: 0.875em; background: var(--bg-alt); padding: 0.1em 0.3em; border-radius: 3px; color: var(--text); }
  .code-bullets { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .code-bullets li { font-size: 0.8125rem; color: var(--text-2); padding-left: 1.25rem; position: relative; line-height: 1.5; }
  .code-bullets li::before { content: '✓'; position: absolute; left: 0; color: var(--accent); font-size: 0.75rem; font-weight: 700; }

  .code-block { background: #1c1c1e; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid #3a3a3c; }
  .code-header { display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0.875rem; background: #2c2c2e; border-bottom: 1px solid #3a3a3c; }
  .code-dots { display: flex; gap: 0.3rem; }
  .code-dots span { width: 10px; height: 10px; border-radius: 50%; }
  .code-dots span:nth-child(1) { background: #ff5f57; }
  .code-dots span:nth-child(2) { background: #febc2e; }
  .code-dots span:nth-child(3) { background: #28c840; }
  .code-filename { font-family: var(--font-mono); font-size: 0.6875rem; color: #8e8e93; }
  .code-pre { padding: 1rem 1.125rem; overflow-x: auto; font-size: 0.75rem; line-height: 1.7; color: #e6edf3; scrollbar-width: thin; scrollbar-color: #3a3a3c transparent; }
  .code-pre :global(.k) { color: #ff7b72; }
  .code-pre :global(.s) { color: #a5d6ff; }
  .code-pre :global(.c) { color: #8b949e; font-style: italic; }
  .code-pre :global(.n) { color: #79c0ff; }

  .edges-section { padding-block: 5rem; background: var(--bg-alt); border-top: 1px solid var(--border-light); }
  .section-sub { margin-bottom: 3rem; }
  .section-sub code { font-family: var(--font-mono); font-size: 0.9em; color: var(--accent); background: var(--accent-bg); padding: 0.1em 0.35em; border-radius: 4px; }
  .edges-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem; }
  .edge-card { background: white; border: 1px solid var(--border-light); border-radius: var(--radius-lg); padding: 1.5rem; display: flex; flex-direction: column; gap: 0.875rem; box-shadow: var(--shadow-xs); }
  .edge-num { font-family: var(--font-mono); font-size: 0.7rem; font-weight: 700; color: var(--accent); letter-spacing: 0.1em; }
  .edge-title { font-size: 1rem; font-weight: 700; letter-spacing: -0.01em; color: var(--text); }
  .edge-desc { font-size: 0.8125rem; color: var(--text-2); line-height: 1.6; }
  .edge-note { font-size: 0.7875rem; color: var(--text-3); line-height: 1.55; padding-top: 0.5rem; border-top: 1px solid var(--border-light); }
  .edge-solution { display: flex; flex-direction: column; gap: 0.5rem; }
  .solution-step { display: flex; align-items: flex-start; gap: 0.625rem; font-size: 0.8125rem; color: var(--text-2); line-height: 1.5; }
  .step-num { width: 20px; height: 20px; border-radius: 50%; background: var(--accent-bg); color: var(--accent); font-size: 0.65rem; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 1px; }

  .related-section { padding-block: 3.5rem; background: var(--bg); border-top: 1px solid var(--border-light); }
  .related-title { font-size: 1.125rem; font-weight: 700; margin-bottom: 1.25rem; letter-spacing: -0.01em; }
  .related-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 0.75rem; }
  .related-card { display: flex; flex-direction: column; gap: 0.375rem; padding: 1rem 1.25rem; background: var(--bg-alt); border: 1px solid var(--border-light); border-radius: var(--radius); text-decoration: none; transition: background 0.15s; }
  .related-card:hover { background: white; text-decoration: none; }
  .related-tag { font-family: var(--font-mono); font-size: 0.6rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: var(--text-3); }
  .related-name { font-size: 0.9375rem; font-weight: 600; color: var(--accent); }

  @media (max-width: 860px) {
    .code-grid { grid-template-columns: minmax(0, 1fr); }
    .edges-grid { grid-template-columns: minmax(0, 1fr); }
    .code-grid > *, .edge-card { min-width: 0; }
    .related-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
