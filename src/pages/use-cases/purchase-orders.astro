---
import UseCaseLayout from '../../layouts/UseCaseLayout.astro';

function hl(raw: string): string {
  return raw
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/(\/\/[^\n]*)/g, '<span class="c">$1</span>')
    .replace(/('[^'\\]*(?:\\.[^'\\]*)*')/g, '<span class="s">$1</span>')
    .replace(/("[^"\\]*(?:\\.[^"\\]*)*")/g, '<span class="s">$1</span>')
    .replace(/\b(async|await|const|let|if|else|return|new|import|from|export|true|false)\b/g, '<span class="k">$1</span>')
    .replace(/\b([0-9][0-9_]*(?:\.[0-9]+)?)\b/g, '<span class="n">$1</span>');
}

const configCode = hl(`engine.defineTemplate({
  name: 'purchase-order',
  schema: POSchema,
  buildChain: async (data, tenantId) => {
    const levels = [];

    // Level 1: Direct manager always
    levels.push({
      levelOrder: 1,
      approvers: [{ approverType: 'role', value: 'direct-manager' }],
      slaHours: 48,
    });

    // Department-specific routing
    if (data.department === 'it') {
      levels.push({
        levelOrder: 2,
        approvers: [{ approverType: 'role', value: 'it-director' }],
        slaHours: 72,
      });
      // Enterprise software requires Security sign-off
      if (data.isEnterpriseContract) {
        levels.push({
          levelOrder: 3,
          approvers: [{ approverType: 'role', value: 'security-officer' }],
          slaHours: 96,
        });
      }
    } else if (data.department === 'marketing') {
      if (data.amount > 5_000) {
        levels.push({
          levelOrder: 2,
          approvers: [{ approverType: 'role', value: 'marketing-director' }],
          slaHours: 72,
        });
      }
    } else {
      levels.push({
        levelOrder: 2,
        approvers: [{ approverType: 'role', value: 'operations-head' }],
        slaHours: 72,
      });
    }

    // Finance required for all POs over $10,000
    if (data.amount > 10_000) {
      levels.push({
        levelOrder: levels.length + 1,
        approvers: [{ approverType: 'role', value: 'finance-controller' }],
        slaHours: 96,
      });
    }

    return { levels, mode: 'sequential' };
  },
});`);

const splitPOCode = hl(`// Check for split PO (same vendor, recent PO from same user)
async function detectSplitPO(
  tenantId: string,
  vendorId: string,
  submittedBy: string,
  newAmount: number
): Promise<{ isSplit: boolean; combinedAmount: number }> {
  const recent = await db.query(
    \`SELECT SUM(data->>'amount') as total
     FROM approval_instances
     WHERE tenant_id = $1
       AND data->>'vendorId' = $2
       AND submitted_by = $3
       AND status = 'pending'
       AND submitted_at > NOW() - INTERVAL '30 days'\`,
    [tenantId, vendorId, submittedBy]
  );

  const existing = parseFloat(recent.rows[0].total || '0');
  const combined = existing + newAmount;

  return {
    isSplit: combined > 10_000 && newAmount <= 10_000,
    combinedAmount: combined,
  };
}

// Use before engine.submit()
const split = await detectSplitPO(tenantId, vendorId, userId, amount);
if (split.isSplit) {
  throw new Error(\`Split PO detected: combined total \${split.combinedAmount}\`);
}`);

const overrideCode = hl(`// Emergency procurement: admin overrides approval immediately
await engine.override({
  tenantId: 'acme-corp',
  instanceId: instance.id,
  actorId: 'admin-cso',
  outcome: 'approved',
  comment: 'Emergency server replacement - P0 incident, board notified',
  reason: 'emergency-procurement',
});

// Audit trail records:
// { action: 'override', actorId: 'admin-cso', reason: 'emergency-procurement',
//   comment: '...', outcome: 'approved', timestamp: '...' }`);
---

<UseCaseLayout
  title="Purchase Order Routing"
  description="Department-specific PO routing with amount escalation. IT, Operations, and Marketing each follow different chain templates. Finance added for all POs over $10k."
  tag="Procurement"
>
  <section class="uc-hero">
    <div class="container">
      <div class="uc-tag-row">
        <span class="uc-tag" style="color:#b45309">Procurement</span>
        <span class="uc-badge">purchase-order</span>
      </div>
      <h1 class="uc-title">Purchase Order Routing</h1>
      <p class="uc-sub">
        IT, Operations, and Marketing each have their own approval chain.
        Enterprise software requires Security sign-off. Finance steps in above $10k.
        Split PO detection catches attempts to circumvent approval thresholds.
      </p>
    </div>
  </section>

  <section class="chain-section">
    <div class="container">
      <div class="section-label-sm">Approval chains by department</div>
      <div class="chains-table">
        <div class="chain-row">
          <span class="chain-type">IT Procurement</span>
          <div class="chain-flow">
            <div class="cf-node cf-always"><span class="cf-name">Manager</span></div>
            <span class="cf-arrow">→</span>
            <div class="cf-node cf-always"><span class="cf-name">IT Director</span></div>
            <span class="cf-arrow">→</span>
            <div class="cf-node cf-cond"><span class="cf-cond-label">if enterprise</span><span class="cf-name">Security</span></div>
            <span class="cf-arrow">→</span>
            <div class="cf-node cf-cond"><span class="cf-cond-label">if &gt; $10k</span><span class="cf-name">Finance</span></div>
          </div>
        </div>
        <div class="chain-row">
          <span class="chain-type">Marketing</span>
          <div class="chain-flow">
            <div class="cf-node cf-always"><span class="cf-name">Manager</span></div>
            <span class="cf-arrow">→</span>
            <div class="cf-node cf-cond"><span class="cf-cond-label">if &gt; $5k</span><span class="cf-name">Mkt Director</span></div>
            <span class="cf-arrow">→</span>
            <div class="cf-node cf-cond"><span class="cf-cond-label">if &gt; $10k</span><span class="cf-name">Finance</span></div>
          </div>
        </div>
        <div class="chain-row">
          <span class="chain-type">Operations</span>
          <div class="chain-flow">
            <div class="cf-node cf-always"><span class="cf-name">Manager</span></div>
            <span class="cf-arrow">→</span>
            <div class="cf-node cf-always"><span class="cf-name">Ops Head</span></div>
            <span class="cf-arrow">→</span>
            <div class="cf-node cf-cond"><span class="cf-cond-label">if &gt; $10k</span><span class="cf-name">Finance</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="code-section">
    <div class="container code-grid">
      <div class="code-meta">
        <span class="section-label-sm">Configuration</span>
        <h2 class="code-heading">Department-aware chain builder</h2>
        <p class="code-desc">
          A single <code>purchase-order</code> template handles all three departments.
          The chain branches inside <code>buildChain</code> based on <code>data.department</code>.
        </p>
        <ul class="code-bullets">
          <li>IT always routes through IT Director</li>
          <li>Enterprise contracts add Security sign-off</li>
          <li>Marketing only adds director above $5k</li>
          <li>Finance is a universal gate above $10k</li>
        </ul>
      </div>
      <div class="code-block">
        <div class="code-header">
          <span class="code-dots"><span></span><span></span><span></span></span>
          <span class="code-filename">po-template.ts</span>
        </div>
        <pre class="code-pre"><code><Fragment set:html={configCode} /></code></pre>
      </div>
    </div>
  </section>

  <section class="edges-section">
    <div class="container">
      <span class="section-label">Edge cases</span>
      <h2 class="section-title">Three scenarios that break hand-rolled PO systems.</h2>
      <p class="section-sub">Each one involves state coordination that a simple if/else can't handle safely.</p>

      <div class="edges-grid">
        <div class="edge-card">
          <div class="edge-num">01</div>
          <h3 class="edge-title">Split PO detection</h3>
          <p class="edge-desc">
            An employee submits a $9,999 PO on Monday and a $8,000 PO to the same vendor on
            Wednesday — both under the $10k Finance threshold. Combined: $17,999.
          </p>
          <div class="code-block">
            <div class="code-header">
              <span class="code-dots"><span></span><span></span><span></span></span>
              <span class="code-filename">split-po.ts</span>
            </div>
            <pre class="code-pre"><code><Fragment set:html={splitPOCode} /></code></pre>
          </div>
          <p class="edge-note">
            Run the check in your API before calling <code>engine.submit()</code>.
            Keep the workflow clean — rejected at the boundary, not mid-flow.
          </p>
        </div>

        <div class="edge-card">
          <div class="edge-num">02</div>
          <h3 class="edge-title">Emergency procurement override</h3>
          <p class="edge-desc">
            A production server fails at 2am. IT needs to order a replacement immediately.
            The normal 48-hour approval cycle isn't viable.
          </p>
          <div class="code-block">
            <div class="code-header">
              <span class="code-dots"><span></span><span></span><span></span></span>
              <span class="code-filename">override.ts</span>
            </div>
            <pre class="code-pre"><code><Fragment set:html={overrideCode} /></code></pre>
          </div>
          <p class="edge-note">
            <code>engine.override()</code> is scoped to admin-level actors. The audit trail
            records the override reason, preserving compliance evidence.
          </p>
        </div>

        <div class="edge-card">
          <div class="edge-num">03</div>
          <h3 class="edge-title">Partial line-item rejection</h3>
          <p class="edge-desc">
            Finance approves the hardware line but rejects the 3-year extended warranty.
            The employee should be able to revise and resubmit just the approved items.
          </p>
          <div class="edge-solution">
            <div class="solution-step">
              <span class="step-num">1</span>
              <span>Finance calls <code>engine.reject()</code> with a comment listing the rejected items</span>
            </div>
            <div class="solution-step">
              <span class="step-num">2</span>
              <span>Employee receives notification with rejection reason</span>
            </div>
            <div class="solution-step">
              <span class="step-num">3</span>
              <span>Employee submits a new, revised PO — the rejected instance is closed in the audit trail</span>
            </div>
          </div>
          <p class="edge-note">
            The rejected instance stays in the audit trail as <code>status: rejected</code>.
            The new instance references the original via metadata if you choose to link them.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="related-section">
    <div class="container">
      <h2 class="related-title">Related use cases</h2>
      <div class="related-grid">
        <a href="/use-cases/accounts-payable/" class="related-card">
          <span class="related-tag">Finance & ERP</span>
          <span class="related-name">Accounts Payable →</span>
        </a>
        <a href="/use-cases/expense-reports/" class="related-card">
          <span class="related-tag">Finance & HR</span>
          <span class="related-name">Expense Reports →</span>
        </a>
        <a href="/use-cases/contract-signing/" class="related-card">
          <span class="related-tag">Legal</span>
          <span class="related-name">Contract Signing →</span>
        </a>
      </div>
    </div>
  </section>
</UseCaseLayout>

<style>
  .uc-hero { padding-block: 3.5rem 2.5rem; background: var(--bg); border-bottom: 1px solid var(--border-light); }
  .uc-tag-row { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.25rem; }
  .uc-tag { font-family: var(--font-mono); font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; }
  .uc-badge { font-family: var(--font-mono); font-size: 0.7rem; background: var(--bg-alt); border: 1px solid var(--border-light); color: var(--text-3); padding: 0.175rem 0.5rem; border-radius: 4px; }
  .uc-title { font-size: clamp(1.75rem, 3.5vw, 2.75rem); font-weight: 700; letter-spacing: -0.03em; margin-bottom: 1rem; }
  .uc-sub { font-size: 1.0625rem; color: var(--text-2); line-height: 1.65; max-width: 58ch; }

  .chain-section { padding-block: 2.5rem; background: var(--bg-alt); border-bottom: 1px solid var(--border-light); }
  .section-label-sm { font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); display: block; margin-bottom: 1.25rem; }
  .chains-table { display: flex; flex-direction: column; gap: 0.75rem; }
  .chain-row { display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap; }
  .chain-type { font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-3); min-width: 120px; }
  .chain-flow { display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap; }

  .cf-node { display: flex; flex-direction: column; align-items: center; gap: 0.2rem; padding: 0.5rem 0.75rem; border-radius: var(--radius); border: 1.5px solid var(--border); background: white; min-width: 76px; }
  .cf-always { border-color: var(--accent); background: var(--accent-bg); }
  .cf-cond   { border-color: var(--border-light); }
  .cf-cond-label { font-family: var(--font-mono); font-size: 0.55rem; color: var(--text-3); }
  .cf-name { font-size: 0.75rem; font-weight: 600; color: var(--text); }
  .cf-arrow { color: var(--border); font-size: 1.25rem; }

  .code-section { padding-block: 4rem; background: var(--bg); border-top: 1px solid var(--border-light); }
  .code-grid { display: grid; grid-template-columns: 280px 1fr; gap: 3rem; align-items: start; }
  .code-heading { font-size: 1.375rem; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 0.75rem; margin-top: 0.5rem; }
  .code-desc { font-size: 0.875rem; color: var(--text-2); line-height: 1.65; margin-bottom: 1rem; }
  .code-desc code, .edge-note code { font-family: var(--font-mono); font-size: 0.875em; background: var(--bg-alt); padding: 0.1em 0.3em; border-radius: 3px; color: var(--text); }
  .code-bullets { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .code-bullets li { font-size: 0.8125rem; color: var(--text-2); padding-left: 1.25rem; position: relative; line-height: 1.5; }
  .code-bullets li::before { content: '✓'; position: absolute; left: 0; color: var(--accent); font-size: 0.75rem; font-weight: 700; }

  .code-block { background: #1c1c1e; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid #3a3a3c; }
  .code-header { display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0.875rem; background: #2c2c2e; border-bottom: 1px solid #3a3a3c; }
  .code-dots { display: flex; gap: 0.3rem; }
  .code-dots span { width: 10px; height: 10px; border-radius: 50%; }
  .code-dots span:nth-child(1) { background: #ff5f57; }
  .code-dots span:nth-child(2) { background: #febc2e; }
  .code-dots span:nth-child(3) { background: #28c840; }
  .code-filename { font-family: var(--font-mono); font-size: 0.6875rem; color: #8e8e93; }
  .code-pre { padding: 1rem 1.125rem; overflow-x: auto; font-size: 0.75rem; line-height: 1.7; color: #e6edf3; scrollbar-width: thin; scrollbar-color: #3a3a3c transparent; }
  .code-pre :global(.k) { color: #ff7b72; }
  .code-pre :global(.s) { color: #a5d6ff; }
  .code-pre :global(.c) { color: #8b949e; font-style: italic; }
  .code-pre :global(.n) { color: #79c0ff; }

  .edges-section { padding-block: 5rem; background: var(--bg-alt); border-top: 1px solid var(--border-light); }
  .section-sub { margin-bottom: 3rem; }
  .edges-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem; }
  .edge-card { background: white; border: 1px solid var(--border-light); border-radius: var(--radius-lg); padding: 1.5rem; display: flex; flex-direction: column; gap: 0.875rem; box-shadow: var(--shadow-xs); }
  .edge-num { font-family: var(--font-mono); font-size: 0.7rem; font-weight: 700; color: var(--accent); letter-spacing: 0.1em; }
  .edge-title { font-size: 1rem; font-weight: 700; letter-spacing: -0.01em; color: var(--text); }
  .edge-desc { font-size: 0.8125rem; color: var(--text-2); line-height: 1.6; }
  .edge-note { font-size: 0.7875rem; color: var(--text-3); line-height: 1.55; padding-top: 0.5rem; border-top: 1px solid var(--border-light); }

  .edge-solution { display: flex; flex-direction: column; gap: 0.5rem; }
  .solution-step { display: flex; align-items: flex-start; gap: 0.625rem; font-size: 0.8125rem; color: var(--text-2); line-height: 1.5; }
  .step-num { width: 20px; height: 20px; border-radius: 50%; background: var(--accent-bg); color: var(--accent); font-size: 0.65rem; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 1px; }
  .solution-step code { font-family: var(--font-mono); font-size: 0.85em; background: var(--bg-alt); padding: 0.1em 0.3em; border-radius: 3px; color: var(--text); }

  .related-section { padding-block: 3.5rem; background: var(--bg); border-top: 1px solid var(--border-light); }
  .related-title { font-size: 1.125rem; font-weight: 700; margin-bottom: 1.25rem; letter-spacing: -0.01em; }
  .related-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 0.75rem; }
  .related-card { display: flex; flex-direction: column; gap: 0.375rem; padding: 1rem 1.25rem; background: var(--bg-alt); border: 1px solid var(--border-light); border-radius: var(--radius); text-decoration: none; transition: background 0.15s; }
  .related-card:hover { background: white; text-decoration: none; }
  .related-tag { font-family: var(--font-mono); font-size: 0.6rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: var(--text-3); }
  .related-name { font-size: 0.9375rem; font-weight: 600; color: var(--accent); }

  @media (max-width: 860px) {
    .code-grid { grid-template-columns: 1fr; }
    .edges-grid { grid-template-columns: 1fr; }
    .related-grid { grid-template-columns: 1fr; }
  }
</style>
