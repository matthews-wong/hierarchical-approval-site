    letter-spacing: -0.01em;
    color: var(--text);
  }

  .edge-desc {
    font-size: 0.8125rem;
    color: var(--text-2);
    line-height: 1.6;
  }

  .edge-note {
    font-size: 0.7875rem;
    color: var(--text-3);
    line-height: 1.55;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border-light);
  }

  /* ── Related ── */
  .related-section {
    padding-block: 3.5rem;
    background: var(--bg);
    border-top: 1px solid var(--border-light);
  }

  .related-title {
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
    letter-spacing: -0.01em;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 0.75rem;
  }

  .related-card {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 1rem 1.25rem;
    background: var(--bg-alt);
    border: 1px solid var(--border-light);
    border-radius: var(--radius);
    text-decoration: none;
    transition: background 0.15s;
  }

  .related-card:hover { background: white; text-decoration: none; }

  .related-tag {
    font-family: var(--font-mono);
    font-size: 0.6rem;
