    box-shadow: var(--shadow-xs);
  }

  .edge-num {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.1em;
  }

  .edge-title {
    font-size: 1rem;
