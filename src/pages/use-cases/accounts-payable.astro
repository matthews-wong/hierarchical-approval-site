---
import UseCaseLayout from '../../layouts/UseCaseLayout.astro';
import { hl } from '../../lib/highlight';

const configCode = hl(`import { ApprovalEngine } from 'hierarchical-approval';
import { PostgresAdapter } from 'hierarchical-approval/adapters/postgres';

const engine = new ApprovalEngine({
  adapter: new PostgresAdapter({ connectionString: process.env.DATABASE_URL }),
  tenantId: 'acme-corp',
  // Resolves every { type: 'role' } approver below
  orgProvider: { getUsersByRole: (role) => directory.usersWithRole(role) },
});

await engine.defineTemplate({
  name: 'accounts-payable',
  documentType: 'invoice',
  // Level 1: department head, always required
  levels: [
    {
      level: 1,
      name: 'Department head',
      approvers: [{ type: 'role', role: 'dept-head' }],
      mode: 'any',
    },
  ],
  // Each rule adds its level when the invoice data matches
  conditions: [
    {
      when: { field: 'amount', operator: '>', value: 1_000 },
      addLevels: [
        {
          level: 2,
          name: 'Finance manager',
          approvers: [{ type: 'role', role: 'finance-manager' }],
          mode: 'any',
        },
      ],
    },
    {
      when: { field: 'amount', operator: '>', value: 10_000 },
      addLevels: [
        {
          level: 3,
          name: 'CFO',
          approvers: [{ type: 'role', role: 'cfo' }],
          mode: 'any',
        },
      ],
    },
    {
      when: { field: 'amount', operator: '>', value: 50_000 },
      addLevels: [
        {
          level: 4,
          name: 'Board',
          approvers: [{ type: 'role', role: 'board-member' }],
          mode: 'any', // any one board member approves
        },
      ],
    },
  ],
  slaDeadlineDays: 7,
});`);

const submitCode = hl(`// Submit an invoice for approval
const instance = await engine.submit({
  templateName: 'accounts-payable',
  documentId: 'INV-2847',
  documentType: 'invoice',
  submittedBy: 'emp-4821',
  data: {
    vendorId: 'vendor-99',
    amount: 15_000,
    currency: 'USD',
    departmentId: 'dept-engineering',
  },
});

// instance.status === 'pending'
// instance.currentLevel === 1  (awaiting the department head)
// instance.levels.length === 3 (amount > 10,000 adds Finance and CFO)
console.log(instance.id);`);

const approveCode = hl(`// Department head approves (level 1)
await engine.approve(instance.id, {
  approverId: 'user-dept-head-42',
  comment: 'Approved - valid vendor contract',
});

// The instance advances to level 2 (Finance manager)
// INotificationAdapter receives approval:level_advanced

// Finance manager approves (level 2)
await engine.approve(instance.id, {
  approverId: 'user-finance-mgr',
  comment: 'Within Q3 budget',
});

// The CFO is now the open level (level 3)...`);

const raceCode = hl(`import { ApprovalConflictError } from 'hierarchical-approval';

// Two approvers act on the same instance at the same moment.
// The storage adapter rejects the stale write; the engine retries it
// (3 attempts by default) before giving up.

try {
  await engine.approve(instanceId, { approverId: 'approver-a' });
} catch (err) {
  if (err instanceof ApprovalConflictError) {
    // Still conflicting after every retry. Re-fetch to see the current state.
    const current = await engine.getInstance(instanceId);
    console.log('Current level:', current.currentLevel);
  }
}`);

const slaCode = hl(`// Wire a real job scheduler for the escalation scan (instead of polling)
import { BullMQScheduler } from './adapters/bullmq-scheduler';

const engine = new ApprovalEngine({
  adapter: new PostgresAdapter({ connectionString: process.env.DATABASE_URL }),
  schedulerAdapter: new BullMQScheduler({ redis: redisConnection }),
  // The engine calls scheduler.scheduleAt(id, runAt, callback) for each scan;
  // BullMQ fires the callback at that time instead of a setInterval poll
});`);

const delegateCode = hl(`// Dept head going on leave: hand the open level to a colleague
await engine.delegate(instance.id, {
  fromApprover: 'user-dept-head-42',
  toApprover: 'user-backup-head',
  reason: 'On leave until 15 Aug',
  until: new Date('2027-08-15'),
});

// 'user-backup-head' can now approve this instance's open level.
// When 'until' passes, the scheduled scan reassigns the seat back to
// 'user-dept-head-42'. The audit trail records the delegation.`);
---

<UseCaseLayout
  title="Accounts Payable Approval"
  description="Multi-level invoice approval chains that auto-scale with transaction amount. Built for AP teams that need a clean audit trail and concurrent-safe approvals."
  tag="Finance & ERP"
>
  <!-- Page hero -->
  <section class="uc-hero">
    <div class="container">
      <div class="uc-tag-row">
        <span class="uc-tag">Finance &amp; ERP</span>
        <span class="uc-badge">accounts-payable</span>
      </div>
      <h1 class="uc-title">Accounts Payable Approval</h1>
      <p class="uc-sub">
        Multi-level invoice approval chains that auto-scale with transaction amount.
        Under $1k needs one sign-off; over $50k routes to the board.
        All built at submission time — no manual chain wiring required.
      </p>
    </div>
  </section>

  <!-- Chain diagram -->
  <section class="chain-section">
    <div class="container">
      <div class="section-label-sm">Approval chain</div>
      <div class="chain-flow" role="img" aria-label="Approval chain: Dept Head always, Finance if over $1k, CFO if over $10k, Board if over $50k">
        <div class="cf-node cf-always">
          <span class="cf-name">Dept Head</span>
          <span class="cf-badge cf-always-badge">always</span>
        </div>
        <div class="cf-arrow" aria-hidden="true">→</div>
        <div class="cf-node cf-cond">
          <span class="cf-cond-label">if &gt; $1k</span>
          <span class="cf-name">Finance Mgr</span>
          <span class="cf-badge cf-cond-badge">conditional</span>
        </div>
        <div class="cf-arrow" aria-hidden="true">→</div>
        <div class="cf-node cf-cond">
          <span class="cf-cond-label">if &gt; $10k</span>
          <span class="cf-name">CFO</span>
          <span class="cf-badge cf-cond-badge">conditional</span>
        </div>
        <div class="cf-arrow" aria-hidden="true">→</div>
        <div class="cf-node cf-cond">
          <span class="cf-cond-label">if &gt; $50k</span>
          <span class="cf-name">Board</span>
          <span class="cf-badge cf-cond-badge">any member</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Configuration -->
  <section class="code-section">
    <div class="container code-grid">
      <div class="code-meta">
        <span class="section-label-sm">Step 1</span>
        <h2 class="code-heading">Define the template</h2>
        <p class="code-desc">
          The first level is static. Each entry in <code>conditions</code> tests the
          invoice <code>data</code> at submission and adds a level when it matches.
          <code>role</code> approvers are resolved through your <code>orgProvider</code>.
        </p>
        <ul class="code-bullets">
          <li>Conditions are evaluated on every <code>engine.submit()</code></li>
          <li>Amount thresholds add levels, so a $500 invoice gets one level and a $60,000 invoice four</li>
          <li>Board level uses <code>mode: 'any'</code> — any one member approves</li>
          <li><code>slaDeadlineDays</code> sets the overall SLA; <code>approval:sla_breached</code> fires when it elapses</li>
        </ul>
      </div>
      <div class="code-block">
        <div class="code-header">
          <span class="code-dots"><span></span><span></span><span></span></span>
          <span class="code-filename">ap-template.ts</span>
        </div>
        <pre class="code-pre"><code><Fragment set:html={configCode} /></code></pre>
      </div>
    </div>
  </section>

  <!-- Submit + Approve -->
  <section class="code-section bg-alt-section">
    <div class="container code-grid reverse">
      <div class="code-meta">
        <span class="section-label-sm">Step 2 &amp; 3</span>
        <h2 class="code-heading">Submit and approve</h2>
        <p class="code-desc">
          <code>engine.submit()</code> evaluates the template's conditions against
          <code>data</code> and creates the instance.
          Each <code>engine.approve()</code> advances to the next level and fires
          your <code>INotificationAdapter</code>.
        </p>
        <ul class="code-bullets">
          <li>Instance stores full audit trail from the start</li>
          <li>Each approval recorded with actor, timestamp, comment</li>
          <li>Final approval sets <code>status: approved</code> automatically</li>
        </ul>
      </div>
      <div>
        <div class="code-block" style="margin-bottom:0.75rem">
          <div class="code-header">
            <span class="code-dots"><span></span><span></span><span></span></span>
            <span class="code-filename">submit.ts</span>
          </div>
          <pre class="code-pre"><code><Fragment set:html={submitCode} /></code></pre>
        </div>
        <div class="code-block">
          <div class="code-header">
            <span class="code-dots"><span></span><span></span><span></span></span>
            <span class="code-filename">approve.ts</span>
          </div>
          <pre class="code-pre"><code><Fragment set:html={approveCode} /></code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- Edge cases -->
  <section class="edges-section">
    <div class="container">
      <span class="section-label">Edge cases</span>
      <h2 class="section-title">The cases you will hit in production.</h2>
      <p class="section-sub">Three scenarios that bring down hand-rolled implementations — all handled by the library.</p>

      <div class="edges-grid">
        <div class="edge-card">
          <div class="edge-num">01</div>
          <h3 class="edge-title">Concurrent approval race condition</h3>
          <p class="edge-desc">
            Two managers in the same approval pool both click "Approve" within milliseconds.
            Without optimistic locking, both writes succeed — corrupting the workflow state.
          </p>
          <div class="code-block">
            <div class="code-header">
              <span class="code-dots"><span></span><span></span><span></span></span>
              <span class="code-filename">handle-conflict.ts</span>
            </div>
            <pre class="code-pre"><code><Fragment set:html={raceCode} /></code></pre>
          </div>
          <p class="edge-note">
            The library increments a <code>version</code> field on every write.
            A stale write throws <code>ApprovalConflictError</code>; the engine retries it
            up to 3 times by default, so you only see the error if the conflict persists.
          </p>
        </div>

        <div class="edge-card">
          <div class="edge-num">02</div>
          <h3 class="edge-title">SLA breach escalation</h3>
          <p class="edge-desc">
            When <code>slaDeadlineDays</code> elapses with no decision, the engine emits
            <code>approval:sla_breached</code>. A level's <code>escalationAfterDays</code> adds
            an escalation approver. Both run on a scan that polls every minute by default;
            production can hand that scan to a real job scheduler.
          </p>
          <div class="code-block">
            <div class="code-header">
              <span class="code-dots"><span></span><span></span><span></span></span>
              <span class="code-filename">scheduler.ts</span>
            </div>
            <pre class="code-pre"><code><Fragment set:html={slaCode} /></code></pre>
          </div>
          <p class="edge-note">
            <code>ISchedulerAdapter</code> receives a deadline and a callback.
            Wire BullMQ, Temporal, or EventBridge — whatever your stack already uses.
          </p>
        </div>

        <div class="edge-card">
          <div class="edge-num">03</div>
          <h3 class="edge-title">Approver on leave — delegation</h3>
          <p class="edge-desc">
            The department head is on vacation. Without delegation, an invoice waiting on
            them sits until it breaches SLA.
          </p>
          <div class="code-block">
            <div class="code-header">
              <span class="code-dots"><span></span><span></span><span></span></span>
              <span class="code-filename">delegate.ts</span>
            </div>
            <pre class="code-pre"><code><Fragment set:html={delegateCode} /></code></pre>
          </div>
          <p class="edge-note">
            Delegation applies to one instance's open level. With <code>until</code> set it
            reverts automatically; omit it for a permanent handoff. For standing cover across
            every invoice, supply an <code>outOfOfficeProvider</code> instead.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Related use cases -->
  <section class="related-section">
    <div class="container">
      <h2 class="related-title">Related use cases</h2>
      <div class="related-grid">
        <a href="/use-cases/expense-reports/" class="related-card">
          <span class="related-tag">Finance & HR</span>
          <span class="related-name">Expense Reimbursement →</span>
        </a>
        <a href="/use-cases/purchase-orders/" class="related-card">
          <span class="related-tag">Procurement</span>
          <span class="related-name">Purchase Order Routing →</span>
        </a>
        <a href="/use-cases/contract-signing/" class="related-card">
          <span class="related-tag">Legal</span>
          <span class="related-name">Contract Signing →</span>
        </a>
      </div>
    </div>
  </section>
</UseCaseLayout>

<style>
  /* ── Hero ── */
  .uc-hero {
    padding-block: 3.5rem 2.5rem;
    background: var(--bg);
    border-bottom: 1px solid var(--border-light);
  }

  .uc-tag-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .uc-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: #1d6fe4;
  }

  .uc-badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    background: var(--bg-alt);
    border: 1px solid var(--border-light);
    color: var(--text-3);
    padding: 0.175rem 0.5rem;
    border-radius: 4px;
  }

  .uc-title {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
  }

  .uc-sub {
    font-size: 1.0625rem;
    color: var(--text-2);
    line-height: 1.65;
    max-width: 58ch;
  }

  /* ── Chain diagram ── */
  .chain-section {
    padding-block: 2.5rem;
    background: var(--bg-alt);
    border-bottom: 1px solid var(--border-light);
  }

  .section-label-sm {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    display: block;
    margin-bottom: 1rem;
  }

  .chain-flow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .cf-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius);
    min-width: 90px;
    border: 1.5px solid var(--border);
    background: white;
  }

  .cf-always { border-color: var(--accent); background: var(--accent-bg); }
  .cf-cond   { border-color: var(--border-light); background: white; }

  .cf-cond-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--text-3);
    letter-spacing: 0.04em;
  }

  .cf-name { font-size: 0.8125rem; font-weight: 600; color: var(--text); }

  .cf-badge {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
  }

  .cf-always-badge { background: var(--accent-bg); color: var(--accent); }
  .cf-cond-badge   { background: var(--bg-alt); color: var(--text-3); }

  .cf-arrow { color: var(--border); font-size: 1.25rem; }

  /* ── Code sections ── */
  .code-section { padding-block: 4rem; background: var(--bg); border-top: 1px solid var(--border-light); }
  .bg-alt-section { background: var(--bg-alt); }

  .code-grid {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 3rem;
    align-items: start;
  }

  .code-grid.reverse { grid-template-columns: 1fr 280px; }
  .code-grid.reverse .code-meta { order: 2; }
  .code-grid.reverse > div:first-child { order: 1; }

  .code-heading {
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
    margin-top: 0.5rem;
  }

  .code-desc {
    font-size: 0.875rem;
    color: var(--text-2);
    line-height: 1.65;
    margin-bottom: 1rem;
  }

  .code-desc code, .edge-note code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--bg-alt);
    padding: 0.1em 0.3em;
    border-radius: 3px;
    color: var(--text);
  }

  .code-bullets {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .code-bullets li {
    font-size: 0.8125rem;
    color: var(--text-2);
    padding-left: 1.25rem;
    position: relative;
    line-height: 1.5;
  }

  .code-bullets li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .code-bullets code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--bg-alt);
    padding: 0.1em 0.3em;
    border-radius: 3px;
    color: var(--text);
  }

  /* Code block */
  .code-block {
    background: #1c1c1e;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid #3a3a3c;
  }

  .code-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.875rem;
    background: #2c2c2e;
    border-bottom: 1px solid #3a3a3c;
  }

  .code-dots {
    display: flex;
    gap: 0.3rem;
  }

  .code-dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #3a3a3c;
  }

  .code-dots span:nth-child(1) { background: #ff5f57; }
  .code-dots span:nth-child(2) { background: #febc2e; }
  .code-dots span:nth-child(3) { background: #28c840; }

  .code-filename {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: #8e8e93;
  }

  .code-pre {
    padding: 1rem 1.125rem;
    overflow-x: auto;
    font-size: 0.75rem;
    line-height: 1.7;
    scrollbar-width: thin;
    scrollbar-color: #3a3a3c transparent;
    color: #e6edf3;
  }

  .code-pre :global(.k) { color: #ff7b72; }
  .code-pre :global(.s) { color: #a5d6ff; }
  .code-pre :global(.c) { color: #8b949e; font-style: italic; }
  .code-pre :global(.n) { color: #79c0ff; }

  /* ── Edge cases ── */
  .edges-section {
    padding-block: 5rem;
    background: var(--bg-alt);
    border-top: 1px solid var(--border-light);
  }

  .section-sub { margin-bottom: 3rem; }

  .edges-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .edge-card {
    background: white;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
