---
import UseCaseLayout from '../../layouts/UseCaseLayout.astro';
import { hl } from '../../lib/highlight';

const configCode = hl(`const ContractSchema = z.object({
  contractId: z.string(),
  counterpartyId: z.string(),
  totalValue: z.number(),
  durationMonths: z.number(),
  contractType: z.enum(['vendor', 'customer', 'partnership', 'employment']),
  requiresCounterSignature: z.boolean(),
  isAmendment: z.boolean().default(false),
  originalContractId: z.string().optional(),
});

engine.defineTemplate({
  name: 'contract-signing',
  schema: ContractSchema,
  buildChain: async (data, tenantId) => {
    const levels = [];

    // Level 1: Department head initiates
    levels.push({
      levelOrder: 1,
      approvers: [{ approverType: 'role', value: 'department-head' }],
      slaHours: 72,
    });

    // Level 2: Legal review always required
    levels.push({
      levelOrder: 2,
      approvers: [
        { approverType: 'role', value: 'legal-counsel' },
        { approverType: 'role', value: 'legal-reviewer' },
      ],
      requireAll: false, // Either legal approver can clear it
      slaHours: 120,
    });

    // Level 3: Finance for high-value or long-duration contracts
    if (data.totalValue > 50_000 || data.durationMonths > 24) {
      levels.push({
        levelOrder: 3,
        approvers: [{ approverType: 'role', value: 'cfo' }],
        slaHours: 96,
      });
    }

    // Level 4: Board for very high-value contracts
    if (data.totalValue > 250_000) {
      levels.push({
        levelOrder: 4,
        approvers: [
          { approverType: 'role', value: 'ceo' },
          { approverType: 'role', value: 'board-chair' },
        ],
        requireAll: true, // Both CEO and board chair must sign
        slaHours: 168,
      });
    }

    return { levels, mode: 'sequential' };
  },
});`);

const amendmentCode = hl(`// Amendment restarts the approval chain with the new value
async function submitAmendment(
  tenantId: string,
  originalInstanceId: string,
  amendedData: ContractData
) {
  // Close the original instance
  await engine.reject({
    tenantId,
    instanceId: originalInstanceId,
    actorId: 'system',
    comment: 'Superseded by amendment',
  });

  // Submit new instance for the amended contract
  const amendedInstance = await engine.submit({
    tenantId,
    templateName: 'contract-signing',
    submittedBy: amendedData.submittedBy,
    data: {
      ...amendedData,
      isAmendment: true,
      originalContractId: originalInstanceId,
    },
  });

  // If the amended value crosses a new threshold, extra levels are added automatically
  // e.g., original $45k → amended $60k now requires CFO sign-off
  return amendedInstance;
}`);

const counterSignCode = hl(`// Receive counter-signature via webhook from DocuSign / Adobe Sign
app.post('/webhooks/docusign', async (req, res) => {
  const { envelopeId, status, signerEmail } = req.body;

  if (status !== 'completed') {
    return res.sendStatus(200);
  }

  // Look up which approval instance this envelope belongs to
  const mapping = await db.query(
    'SELECT instance_id, tenant_id FROM contract_envelopes WHERE envelope_id = $1',
    [envelopeId]
  );

  const { instance_id, tenant_id } = mapping.rows[0];

  // Record the external counter-signature as an approval
  await engine.approve({
    tenantId: tenant_id,
    instanceId: instance_id,
    actorId: \`external:\${signerEmail}\`,
    comment: \`Counter-signed via DocuSign by \${signerEmail}\`,
  });

  res.sendStatus(200);
});`);
---

<UseCaseLayout
  title="Contract Approval Pipeline"
  description="Legal review before every contract execution. High-value contracts add Finance and board levels. Amendments to approved contracts restart the chain automatically."
  tag="Legal"
>
  <section class="uc-hero">
    <div class="container">
      <div class="uc-tag-row">
        <span class="uc-tag" style="color:#1a7a45">Legal</span>
        <span class="uc-badge">contract-signing</span>
      </div>
      <h1 class="uc-title">Contract Approval Pipeline</h1>
      <p class="uc-sub">
        Every contract goes through Legal before execution. Large contracts or long-term agreements
        add Finance and Board levels. Either legal approver can clear the review.
        For board-level contracts, both CEO and board chair must sign.
      </p>
    </div>
  </section>

  <section class="chain-section">
    <div class="container">
      <div class="section-label-sm">Approval chain by contract value</div>
      <div class="chains-table">
        <div class="chain-row">
          <span class="chain-type">Under $50k</span>
          <div class="chain-flow">
            <div class="cf-node cf-always"><span class="cf-name">Dept Head</span></div>
            <span class="cf-arrow">→</span>
            <div class="cf-node cf-always" style="border-color:#7c3aed;background:#f5f3ff"><span class="cf-name">Legal</span><span class="cf-badge-sm">any one</span></div>
            <span class="cf-arrow">→</span>
            <div class="cf-node cf-done"><span class="cf-name">Signed</span></div>
          </div>
        </div>
        <div class="chain-row">
          <span class="chain-type">$50k – $250k</span>
          <div class="chain-flow">
            <div class="cf-node cf-always"><span class="cf-name">Dept Head</span></div>
            <span class="cf-arrow">→</span>
            <div class="cf-node cf-always" style="border-color:#7c3aed;background:#f5f3ff"><span class="cf-name">Legal</span></div>
            <span class="cf-arrow">→</span>
            <div class="cf-node cf-cond"><span class="cf-name">CFO</span></div>
            <span class="cf-arrow">→</span>
            <div class="cf-node cf-done"><span class="cf-name">Signed</span></div>
          </div>
        </div>
        <div class="chain-row">
          <span class="chain-type">Over $250k</span>
          <div class="chain-flow">
            <div class="cf-node cf-always"><span class="cf-name">Dept Head</span></div>
            <span class="cf-arrow">→</span>
            <div class="cf-node cf-always" style="border-color:#7c3aed;background:#f5f3ff"><span class="cf-name">Legal</span></div>
            <span class="cf-arrow">→</span>
            <div class="cf-node cf-cond"><span class="cf-name">CFO</span></div>
            <span class="cf-arrow">→</span>
            <div class="cf-node cf-cond"><span class="cf-name">CEO + Board</span><span class="cf-badge-sm">both required</span></div>
            <span class="cf-arrow">→</span>
            <div class="cf-node cf-done"><span class="cf-name">Signed</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="code-section">
    <div class="container code-grid">
      <div class="code-meta">
        <span class="section-label-sm">Configuration</span>
        <h2 class="code-heading">Legal always gates execution</h2>
        <p class="code-desc">
          Legal review is a fixed level 2 in every contract chain. It uses
          <code>requireAll: false</code> — either counsel or reviewer can clear it.
          Board-level contracts use <code>requireAll: true</code> — both CEO and board
          chair must sign.
        </p>
        <ul class="code-bullets">
          <li>Legal review cannot be skipped for any contract type</li>
          <li>High-value or long-term adds CFO automatically</li>
          <li>Board approval requires both signatories (requireAll: true)</li>
          <li>SLA tracked at every level — legal gets 5 days</li>
        </ul>
      </div>
      <div class="code-block">
        <div class="code-header">
          <span class="code-dots"><span></span><span></span><span></span></span>
          <span class="code-filename">contract-template.ts</span>
        </div>
        <pre class="code-pre"><code><Fragment set:html={configCode} /></code></pre>
      </div>
    </div>
  </section>

  <section class="edges-section">
    <div class="container">
      <span class="section-label">Edge cases</span>
      <h2 class="section-title">Contract workflows have unusual edge cases.</h2>
      <p class="section-sub">Unlike expense approvals, contracts involve external parties and evolve over their lifecycle.</p>

      <div class="edges-grid">
        <div class="edge-card">
          <div class="edge-num">01</div>
          <h3 class="edge-title">Amendment restarts the chain</h3>
          <p class="edge-desc">
            A $45k contract is approved. The vendor negotiates an extension to $60k.
            The amendment crosses the CFO threshold — it needs a new approval chain,
            not just a note on the old one.
          </p>
          <div class="code-block">
            <div class="code-header">
              <span class="code-dots"><span></span><span></span><span></span></span>
              <span class="code-filename">amendment.ts</span>
            </div>
            <pre class="code-pre"><code><Fragment set:html={amendmentCode} /></code></pre>
          </div>
          <p class="edge-note">
            The original instance is closed as <code>superseded</code>. The audit trail
            links them via <code>originalContractId</code>. New thresholds apply to the amended value.
          </p>
        </div>

        <div class="edge-card">
          <div class="edge-num">02</div>
          <h3 class="edge-title">External counter-signature via webhook</h3>
          <p class="edge-desc">
            The counterparty (a vendor or customer) must also sign before the contract
            is fully executed. Their signature comes from an e-signature platform, not
            from inside your system.
          </p>
          <div class="code-block">
            <div class="code-header">
              <span class="code-dots"><span></span><span></span><span></span></span>
              <span class="code-filename">countersign-webhook.ts</span>
            </div>
            <pre class="code-pre"><code><Fragment set:html={counterSignCode} /></code></pre>
          </div>
          <p class="edge-note">
            Use a synthetic <code>actorId</code> prefixed with <code>external:</code>.
            The audit trail records who signed externally, keeping compliance records accurate.
          </p>
        </div>

        <div class="edge-card">
          <div class="edge-num">03</div>
          <h3 class="edge-title">Legal hold mid-approval</h3>
          <p class="edge-desc">
            A contract is at the CFO level awaiting approval when legal sends a hold
            because of a regulatory review. The CFO should not be able to approve until the hold is lifted.
          </p>
          <div class="edge-solution">
            <div class="solution-step">
              <span class="step-num">1</span>
              <span>Legal team sets a <code>hold</code> flag on the instance in your DB</span>
            </div>
            <div class="solution-step">
              <span class="step-num">2</span>
              <span>Implement <code>IAuthorizationPolicy.authorize()</code> to return a blocking message when the hold flag is set</span>
            </div>
            <div class="solution-step">
              <span class="step-num">3</span>
              <span>When legal lifts the hold, the CFO can approve normally — the approval history is unaffected</span>
            </div>
          </div>
          <p class="edge-note">
            <code>IAuthorizationPolicy</code> is called on every operation. Returning a non-null string
            blocks the action with that message — without corrupting the instance state.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="related-section">
    <div class="container">
      <h2 class="related-title">Related use cases</h2>
      <div class="related-grid">
        <a href="/use-cases/accounts-payable/" class="related-card">
          <span class="related-tag">Finance & ERP</span>
          <span class="related-name">Accounts Payable →</span>
        </a>
        <a href="/use-cases/purchase-orders/" class="related-card">
          <span class="related-tag">Procurement</span>
          <span class="related-name">Purchase Orders →</span>
        </a>
        <a href="/use-cases/multi-tenant-saas/" class="related-card">
          <span class="related-tag">SaaS Architecture</span>
          <span class="related-name">Multi-Tenant SaaS →</span>
        </a>
      </div>
    </div>
  </section>
</UseCaseLayout>

<style>
  .uc-hero { padding-block: 3.5rem 2.5rem; background: var(--bg); border-bottom: 1px solid var(--border-light); }
  .uc-tag-row { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.25rem; }
  .uc-tag { font-family: var(--font-mono); font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; }
  .uc-badge { font-family: var(--font-mono); font-size: 0.7rem; background: var(--bg-alt); border: 1px solid var(--border-light); color: var(--text-3); padding: 0.175rem 0.5rem; border-radius: 4px; }
  .uc-title { font-size: clamp(1.75rem, 3.5vw, 2.75rem); font-weight: 700; letter-spacing: -0.03em; margin-bottom: 1rem; }
  .uc-sub { font-size: 1.0625rem; color: var(--text-2); line-height: 1.65; max-width: 58ch; }

  .chain-section { padding-block: 2.5rem; background: var(--bg-alt); border-bottom: 1px solid var(--border-light); }
  .section-label-sm { font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); display: block; margin-bottom: 1.25rem; }
  .chains-table { display: flex; flex-direction: column; gap: 0.75rem; }
  .chain-row { display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap; }
  .chain-type { font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-3); min-width: 110px; }
  .chain-flow { display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap; }
  .cf-node { display: flex; flex-direction: column; align-items: center; gap: 0.2rem; padding: 0.5rem 0.75rem; border-radius: var(--radius); border: 1.5px solid var(--border); background: white; min-width: 72px; }
  .cf-always { border-color: var(--accent); background: var(--accent-bg); }
  .cf-cond { border-color: var(--border-light); }
  .cf-done { border-color: var(--accent); background: #d1fae5; }
  .cf-name { font-size: 0.75rem; font-weight: 600; color: var(--text); text-align: center; }
  .cf-badge-sm { font-family: var(--font-mono); font-size: 0.5rem; color: var(--text-3); text-align: center; }
  .cf-arrow { color: var(--border); font-size: 1.25rem; }

  .code-section { padding-block: 4rem; background: var(--bg); border-top: 1px solid var(--border-light); }
  .code-grid { display: grid; grid-template-columns: 280px 1fr; gap: 3rem; align-items: start; }
  .code-heading { font-size: 1.375rem; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 0.75rem; margin-top: 0.5rem; }
  .code-desc { font-size: 0.875rem; color: var(--text-2); line-height: 1.65; margin-bottom: 1rem; }
  .code-desc code, .edge-note code { font-family: var(--font-mono); font-size: 0.875em; background: var(--bg-alt); padding: 0.1em 0.3em; border-radius: 3px; color: var(--text); }
  .code-bullets { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .code-bullets li { font-size: 0.8125rem; color: var(--text-2); padding-left: 1.25rem; position: relative; line-height: 1.5; }
  .code-bullets li::before { content: '✓'; position: absolute; left: 0; color: var(--accent); font-size: 0.75rem; font-weight: 700; }

  .code-block { background: #1c1c1e; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid #3a3a3c; }
  .code-header { display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0.875rem; background: #2c2c2e; border-bottom: 1px solid #3a3a3c; }
  .code-dots { display: flex; gap: 0.3rem; }
  .code-dots span { width: 10px; height: 10px; border-radius: 50%; }
  .code-dots span:nth-child(1) { background: #ff5f57; }
  .code-dots span:nth-child(2) { background: #febc2e; }
  .code-dots span:nth-child(3) { background: #28c840; }
  .code-filename { font-family: var(--font-mono); font-size: 0.6875rem; color: #8e8e93; }
  .code-pre { padding: 1rem 1.125rem; overflow-x: auto; font-size: 0.75rem; line-height: 1.7; color: #e6edf3; scrollbar-width: thin; scrollbar-color: #3a3a3c transparent; }
  .code-pre :global(.k) { color: #ff7b72; }
  .code-pre :global(.s) { color: #a5d6ff; }
  .code-pre :global(.c) { color: #8b949e; font-style: italic; }
  .code-pre :global(.n) { color: #79c0ff; }

  .edges-section { padding-block: 5rem; background: var(--bg-alt); border-top: 1px solid var(--border-light); }
  .section-sub { margin-bottom: 3rem; }
  .edges-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem; }
  .edge-card { background: white; border: 1px solid var(--border-light); border-radius: var(--radius-lg); padding: 1.5rem; display: flex; flex-direction: column; gap: 0.875rem; box-shadow: var(--shadow-xs); }
  .edge-num { font-family: var(--font-mono); font-size: 0.7rem; font-weight: 700; color: var(--accent); letter-spacing: 0.1em; }
  .edge-title { font-size: 1rem; font-weight: 700; letter-spacing: -0.01em; color: var(--text); }
  .edge-desc { font-size: 0.8125rem; color: var(--text-2); line-height: 1.6; }
  .edge-note { font-size: 0.7875rem; color: var(--text-3); line-height: 1.55; padding-top: 0.5rem; border-top: 1px solid var(--border-light); }
  .edge-solution { display: flex; flex-direction: column; gap: 0.5rem; }
  .solution-step { display: flex; align-items: flex-start; gap: 0.625rem; font-size: 0.8125rem; color: var(--text-2); line-height: 1.5; }
  .step-num { width: 20px; height: 20px; border-radius: 50%; background: var(--accent-bg); color: var(--accent); font-size: 0.65rem; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 1px; }
  .solution-step code { font-family: var(--font-mono); font-size: 0.85em; background: var(--bg-alt); padding: 0.1em 0.3em; border-radius: 3px; color: var(--text); }

  .related-section { padding-block: 3.5rem; background: var(--bg); border-top: 1px solid var(--border-light); }
  .related-title { font-size: 1.125rem; font-weight: 700; margin-bottom: 1.25rem; letter-spacing: -0.01em; }
  .related-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 0.75rem; }
  .related-card { display: flex; flex-direction: column; gap: 0.375rem; padding: 1rem 1.25rem; background: var(--bg-alt); border: 1px solid var(--border-light); border-radius: var(--radius); text-decoration: none; transition: background 0.15s; }
  .related-card:hover { background: white; text-decoration: none; }
  .related-tag { font-family: var(--font-mono); font-size: 0.6rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: var(--text-3); }
  .related-name { font-size: 0.9375rem; font-weight: 600; color: var(--accent); }

  @media (max-width: 860px) {
    .code-grid { grid-template-columns: minmax(0, 1fr); }
    .edges-grid { grid-template-columns: minmax(0, 1fr); }
    .code-grid > *, .edge-card { min-width: 0; }
    .related-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
