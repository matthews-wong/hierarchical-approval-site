---
import UseCaseLayout from '../../layouts/UseCaseLayout.astro';
import { hl } from '../../lib/highlight';

const configCode = hl(`// Tenant-configured chains stored in your database
interface TenantApprovalConfig {
  tenantId: string;
  levels: Array<{
    order: number;
    approverRoles: string[];
    requireAll: boolean;
    slaHours: number;
  }>;
}

engine.defineTemplate({
  name: 'tenant-document-approval',
  schema: DocumentSchema,
  buildChain: async (data, tenantId) => {
    // Load tenant custom chain configuration
    const config = await db.query(
      'SELECT * FROM tenant_approval_configs WHERE tenant_id = $1',
      [tenantId]
    );

    if (!config.rows[0]) {
      // Fallback for unconfigured tenants: single admin approver
      return {
        levels: [{
          levelOrder: 1,
          approvers: [{ approverType: 'role', value: 'admin' }],
          slaHours: 48,
        }],
        mode: 'sequential',
      };
    }

    // Build chain from tenant configuration
    const levels = config.rows[0].levels.map((level) => ({
      levelOrder: level.order,
      approvers: level.approverRoles.map((role) => ({
        approverType: 'role',
        value: role,
      })),
      requireAll: level.requireAll,
      slaHours: level.slaHours,
    }));

    return { levels, mode: 'sequential' };
  },
});`);

const suspendCode = hl(`// Block new submissions from suspended tenants while
// allowing existing in-flight approvals to complete
class TenantSuspensionPolicy implements IAuthorizationPolicy {
  async authorize(ctx: AuthorizationContext) {
    // Only block new submissions — not approvals of existing instances
    if (ctx.operation !== 'submit') return undefined;

    const tenant = await db.query(
      'SELECT status FROM tenants WHERE id = $1',
      [ctx.tenantId]
    );

    if (tenant.rows[0]?.status === 'suspended') {
      return 'Tenant account is suspended. Contact support to reactivate.';
    }

    return undefined; // allow
  }
}

const engine = new ApprovalEngine({
  storage: new PostgresAdapter({ connectionString: process.env.DATABASE_URL }),
  authorizationPolicy: new TenantSuspensionPolicy(),
});`);

const validateConfigCode = hl(`// Validate tenant chain config before saving it
function validateChainConfig(config: TenantApprovalConfig): string | null {
  if (!config.levels || config.levels.length === 0) {
    return 'Chain must have at least one level';
  }

  const orders = config.levels.map(l => l.order);
  const hasGap = orders.some((o, i) => o !== i + 1);
  if (hasGap) {
    return 'Level orders must be sequential starting from 1';
  }

  const hasDuplicates = new Set(orders).size !== orders.length;
  if (hasDuplicates) {
    return 'Duplicate level orders found';
  }

  for (const level of config.levels) {
    if (!level.approverRoles || level.approverRoles.length === 0) {
      return \`Level \${level.order} must have at least one approver role\`;
    }
    if (level.slaHours < 1 || level.slaHours > 720) {
      return \`Level \${level.order} SLA must be between 1 and 720 hours\`;
    }
  }

  return null; // valid
}

// In your admin API endpoint:
const error = validateChainConfig(newConfig);
if (error) {
  return res.status(400).json({ error });
}
await db.query(/* upsert config */);`);
---

<UseCaseLayout
  title="Per-Tenant Approval Rules"
  description="Each tenant configures their own approval chain via your admin UI. Basic tenants get a simple template; Enterprise tenants store custom chains in your database."
  tag="SaaS Architecture"
>
  <section class="uc-hero">
    <div class="container">
      <div class="uc-tag-row">
        <span class="uc-tag" style="color:#dc2626">SaaS Architecture</span>
        <span class="uc-badge">multi-tenant</span>
      </div>
      <h1 class="uc-title">Per-Tenant Approval Rules</h1>
      <p class="uc-sub">
        Every call to <code>engine.submit()</code> passes a <code>tenantId</code>.
        Your <code>buildChain</code> function reads that tenant's configuration from
        your database and returns their custom chain. Different tenants, different rules —
        one engine instance.
      </p>
    </div>
  </section>

  <section class="chain-section">
    <div class="container">
      <div class="section-label-sm">Chain examples by tenant plan</div>
      <div class="chains-table">
        <div class="chain-row">
          <span class="chain-type">Basic plan</span>
          <div class="chain-flow">
            <div class="cf-node cf-always"><span class="cf-name">Admin</span><span class="cf-badge-sm">fallback</span></div>
            <span class="cf-arrow">→</span>
            <div class="cf-node cf-done"><span class="cf-name">Approved</span></div>
          </div>
        </div>
        <div class="chain-row">
          <span class="chain-type">Professional</span>
          <div class="chain-flow">
            <div class="cf-node cf-always"><span class="cf-name">Manager</span></div>
            <span class="cf-arrow">→</span>
            <div class="cf-node cf-always"><span class="cf-name">Director</span></div>
            <span class="cf-arrow">→</span>
            <div class="cf-node cf-done"><span class="cf-name">Approved</span></div>
          </div>
        </div>
        <div class="chain-row">
          <span class="chain-type">Enterprise</span>
          <div class="chain-flow">
            <div class="cf-node cf-always"><span class="cf-name">Manager</span></div>
            <span class="cf-arrow">→</span>
            <div class="cf-node cf-always"><span class="cf-name">VP</span></div>
            <span class="cf-arrow">→</span>
            <div class="cf-node cf-always"><span class="cf-name">CFO</span></div>
            <span class="cf-arrow">→</span>
            <div class="cf-node cf-cond"><span class="cf-name">Legal</span><span class="cf-badge-sm">custom</span></div>
            <span class="cf-arrow">→</span>
            <div class="cf-node cf-done"><span class="cf-name">Approved</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="code-section">
    <div class="container code-grid">
      <div class="code-meta">
        <span class="section-label-sm">Configuration</span>
        <h2 class="code-heading">One template, N tenant configs</h2>
        <p class="code-desc">
          <code>buildChain</code> receives <code>tenantId</code> as the second argument.
          Query your <code>tenant_approval_configs</code> table and transform the rows into
          levels. Tenants that haven't configured a chain get the fallback single-approver chain.
        </p>
        <ul class="code-bullets">
          <li>Chain isolated per tenant — no cross-tenant data</li>
          <li>Fallback chain prevents orphan submissions</li>
          <li>Tenant can update config at any time — in-flight instances use their original chain</li>
          <li>No engine restart needed when tenant config changes</li>
        </ul>
      </div>
      <div class="code-block">
        <div class="code-header">
          <span class="code-dots"><span></span><span></span><span></span></span>
          <span class="code-filename">tenant-template.ts</span>
        </div>
        <pre class="code-pre"><code><Fragment set:html={configCode} /></code></pre>
      </div>
    </div>
  </section>

  <section class="edges-section">
    <div class="container">
      <span class="section-label">Edge cases</span>
      <h2 class="section-title">Multi-tenancy introduces unique approval edge cases.</h2>
      <p class="section-sub">These failures only appear at scale — after your first hundred tenants.</p>

      <div class="edges-grid">
        <div class="edge-card">
          <div class="edge-num">01</div>
          <h3 class="edge-title">Tenant suspended mid-approval</h3>
          <p class="edge-desc">
            A tenant's subscription lapses while they have three approval workflows in flight.
            Blocking all operations would freeze legitimate in-progress work and anger approvers
            who are trying to do the right thing.
          </p>
          <div class="code-block">
            <div class="code-header">
              <span class="code-dots"><span></span><span></span><span></span></span>
              <span class="code-filename">suspension-policy.ts</span>
            </div>
            <pre class="code-pre"><code><Fragment set:html={suspendCode} /></code></pre>
          </div>
          <p class="edge-note">
            Block <code>submit</code> for suspended tenants; allow <code>approve</code>/<code>reject</code>
            to complete existing workflows. In-flight approvals resolve cleanly.
          </p>
        </div>

        <div class="edge-card">
          <div class="edge-num">02</div>
          <h3 class="edge-title">Invalid tenant chain configuration</h3>
          <p class="edge-desc">
            A tenant admin accidentally creates a chain with duplicate level orders or
            no approvers on a level. The next submission crashes in <code>buildChain</code>
            with an unhelpful error.
          </p>
          <div class="code-block">
            <div class="code-header">
              <span class="code-dots"><span></span><span></span><span></span></span>
              <span class="code-filename">validate-config.ts</span>
            </div>
            <pre class="code-pre"><code><Fragment set:html={validateConfigCode} /></code></pre>
          </div>
          <p class="edge-note">
            Validate at save time — not at runtime. Return a human-readable error to the
            admin UI before the broken config reaches production.
          </p>
        </div>

        <div class="edge-card">
          <div class="edge-num">03</div>
          <h3 class="edge-title">In-flight instances after config change</h3>
          <p class="edge-desc">
            A tenant updates their chain to add a CFO level. There are 12 approval
            instances already in progress. Should the new level apply to them?
          </p>
          <div class="edge-solution">
            <div class="solution-step">
              <span class="step-num">1</span>
              <span>The chain is built at <code>engine.submit()</code> time and stored on the instance — config changes don't affect in-flight instances</span>
            </div>
            <div class="solution-step">
              <span class="step-num">2</span>
              <span>New submissions after the config change use the updated chain</span>
            </div>
            <div class="solution-step">
              <span class="step-num">3</span>
              <span>Notify the tenant admin that existing workflows complete under the old rules — new ones use the new config</span>
            </div>
          </div>
          <p class="edge-note">
            Immutability of the chain after submission is not a limitation — it's the
            correct behavior. Changing rules mid-workflow would invalidate prior approvals.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="related-section">
    <div class="container">
      <h2 class="related-title">Related use cases</h2>
      <div class="related-grid">
        <a href="/use-cases/accounts-payable/" class="related-card">
          <span class="related-tag">Finance & ERP</span>
          <span class="related-name">Accounts Payable →</span>
        </a>
        <a href="/use-cases/contract-signing/" class="related-card">
          <span class="related-tag">Legal</span>
          <span class="related-name">Contract Signing →</span>
        </a>
        <a href="/use-cases/hr-leave/" class="related-card">
          <span class="related-tag">HR Systems</span>
          <span class="related-name">HR Leave Requests →</span>
        </a>
      </div>
    </div>
  </section>
</UseCaseLayout>

<style>
  .uc-hero { padding-block: 3.5rem 2.5rem; background: var(--bg); border-bottom: 1px solid var(--border-light); }
  .uc-tag-row { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.25rem; }
  .uc-tag { font-family: var(--font-mono); font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; }
  .uc-badge { font-family: var(--font-mono); font-size: 0.7rem; background: var(--bg-alt); border: 1px solid var(--border-light); color: var(--text-3); padding: 0.175rem 0.5rem; border-radius: 4px; }
  .uc-title { font-size: clamp(1.75rem, 3.5vw, 2.75rem); font-weight: 700; letter-spacing: -0.03em; margin-bottom: 1rem; }
  .uc-sub { font-size: 1.0625rem; color: var(--text-2); line-height: 1.65; max-width: 58ch; }
  .uc-sub code { font-family: var(--font-mono); font-size: 0.9em; color: var(--accent); background: var(--accent-bg); padding: 0.1em 0.35em; border-radius: 4px; }

  .chain-section { padding-block: 2.5rem; background: var(--bg-alt); border-bottom: 1px solid var(--border-light); }
  .section-label-sm { font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); display: block; margin-bottom: 1.25rem; }
  .chains-table { display: flex; flex-direction: column; gap: 0.75rem; }
  .chain-row { display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap; }
  .chain-type { font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-3); min-width: 110px; }
  .chain-flow { display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap; }
  .cf-node { display: flex; flex-direction: column; align-items: center; gap: 0.2rem; padding: 0.5rem 0.75rem; border-radius: var(--radius); border: 1.5px solid var(--border); background: white; min-width: 72px; }
  .cf-always { border-color: var(--accent); background: var(--accent-bg); }
  .cf-cond { border-color: var(--border-light); }
  .cf-done { border-color: var(--accent); background: #d1fae5; }
  .cf-name { font-size: 0.75rem; font-weight: 600; color: var(--text); }
  .cf-badge-sm { font-family: var(--font-mono); font-size: 0.5rem; color: var(--text-3); }
  .cf-arrow { color: var(--border); font-size: 1.25rem; }

  .code-section { padding-block: 4rem; background: var(--bg); border-top: 1px solid var(--border-light); }
  .code-grid { display: grid; grid-template-columns: 280px 1fr; gap: 3rem; align-items: start; }
  .code-heading { font-size: 1.375rem; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 0.75rem; margin-top: 0.5rem; }
  .code-desc { font-size: 0.875rem; color: var(--text-2); line-height: 1.65; margin-bottom: 1rem; }
  .code-desc code, .edge-note code { font-family: var(--font-mono); font-size: 0.875em; background: var(--bg-alt); padding: 0.1em 0.3em; border-radius: 3px; color: var(--text); }
  .code-bullets { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .code-bullets li { font-size: 0.8125rem; color: var(--text-2); padding-left: 1.25rem; position: relative; line-height: 1.5; }
  .code-bullets li::before { content: '✓'; position: absolute; left: 0; color: var(--accent); font-size: 0.75rem; font-weight: 700; }

  .code-block { background: #1c1c1e; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid #3a3a3c; }
  .code-header { display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0.875rem; background: #2c2c2e; border-bottom: 1px solid #3a3a3c; }
  .code-dots { display: flex; gap: 0.3rem; }
  .code-dots span { width: 10px; height: 10px; border-radius: 50%; }
  .code-dots span:nth-child(1) { background: #ff5f57; }
  .code-dots span:nth-child(2) { background: #febc2e; }
  .code-dots span:nth-child(3) { background: #28c840; }
  .code-filename { font-family: var(--font-mono); font-size: 0.6875rem; color: #8e8e93; }
  .code-pre { padding: 1rem 1.125rem; overflow-x: auto; font-size: 0.75rem; line-height: 1.7; color: #e6edf3; scrollbar-width: thin; scrollbar-color: #3a3a3c transparent; }
  .code-pre :global(.k) { color: #ff7b72; }
  .code-pre :global(.s) { color: #a5d6ff; }
  .code-pre :global(.c) { color: #8b949e; font-style: italic; }
  .code-pre :global(.n) { color: #79c0ff; }

  .edges-section { padding-block: 5rem; background: var(--bg-alt); border-top: 1px solid var(--border-light); }
  .section-sub { margin-bottom: 3rem; }
  .edges-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem; }
  .edge-card { background: white; border: 1px solid var(--border-light); border-radius: var(--radius-lg); padding: 1.5rem; display: flex; flex-direction: column; gap: 0.875rem; box-shadow: var(--shadow-xs); }
  .edge-num { font-family: var(--font-mono); font-size: 0.7rem; font-weight: 700; color: var(--accent); letter-spacing: 0.1em; }
  .edge-title { font-size: 1rem; font-weight: 700; letter-spacing: -0.01em; color: var(--text); }
  .edge-desc { font-size: 0.8125rem; color: var(--text-2); line-height: 1.6; }
  .edge-note { font-size: 0.7875rem; color: var(--text-3); line-height: 1.55; padding-top: 0.5rem; border-top: 1px solid var(--border-light); }
  .edge-solution { display: flex; flex-direction: column; gap: 0.5rem; }
  .solution-step { display: flex; align-items: flex-start; gap: 0.625rem; font-size: 0.8125rem; color: var(--text-2); line-height: 1.5; }
  .step-num { width: 20px; height: 20px; border-radius: 50%; background: var(--accent-bg); color: var(--accent); font-size: 0.65rem; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 1px; }

  .related-section { padding-block: 3.5rem; background: var(--bg); border-top: 1px solid var(--border-light); }
  .related-title { font-size: 1.125rem; font-weight: 700; margin-bottom: 1.25rem; letter-spacing: -0.01em; }
  .related-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 0.75rem; }
  .related-card { display: flex; flex-direction: column; gap: 0.375rem; padding: 1rem 1.25rem; background: var(--bg-alt); border: 1px solid var(--border-light); border-radius: var(--radius); text-decoration: none; transition: background 0.15s; }
  .related-card:hover { background: white; text-decoration: none; }
  .related-tag { font-family: var(--font-mono); font-size: 0.6rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: var(--text-3); }
  .related-name { font-size: 0.9375rem; font-weight: 600; color: var(--accent); }

  @media (max-width: 860px) {
    .code-grid { grid-template-columns: 1fr; }
    .edges-grid { grid-template-columns: 1fr; }
    .related-grid { grid-template-columns: 1fr; }
  }
</style>
