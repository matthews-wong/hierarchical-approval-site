---
import UseCaseLayout from '../../layouts/UseCaseLayout.astro';
import { hl } from '../../lib/highlight';

const configCode = hl(`import { ApprovalEngine } from 'hierarchical-approval';
import { PostgresAdapter } from 'hierarchical-approval/adapters/postgres';

const engine = new ApprovalEngine({
  adapter: new PostgresAdapter({ connectionString: process.env.DATABASE_URL }),
  tenantId: 'acme-corp',
  // Resolves every { type: 'role' } approver below
  orgProvider: { getUsersByRole: (role) => directory.usersWithRole(role) },
});

// A { type: 'dynamic' } approver: look up the submitter's direct manager
engine.registerResolver('direct-manager', (submittedBy) => hrSystem.managerIdOf(submittedBy));

await engine.defineTemplate({
  name: 'hr-leave',
  documentType: 'leave-request',
  levels: [
    {
      level: 1,
      name: 'Manager',
      approvers: [{ type: 'dynamic', resolver: 'direct-manager' }],
      mode: 'any',
    },
    {
      level: 3,
      name: 'HR',
      approvers: [{ type: 'role', role: 'hr-admin' }],
      mode: 'any',
    },
  ],
  conditions: [
    // Extended leave (> 10 days) adds the department head between the two
    {
      when: { field: 'durationDays', operator: '>', value: 10 },
      addLevels: [
        {
          level: 2,
          name: 'Department head',
          approvers: [{ type: 'role', role: 'dept-head' }],
          mode: 'any',
        },
      ],
    },
    // Short sick leave (< 3 days) skips HR
    {
      when: {
        all: [
          { field: 'leaveType', operator: '==', value: 'sick' },
          { field: 'durationDays', operator: '<', value: 3 },
        ],
      },
      skipLevels: [3],
    },
    // Emergency leave skips the manager and goes straight to HR
    {
      when: { field: 'leaveType', operator: '==', value: 'emergency' },
      skipLevels: [1],
    },
  ],
});`);

const delegateCode = hl(`// Standing cover: consulted whenever a level's approvers are resolved,
// so a manager who is away is replaced before the request reaches them
const engine = new ApprovalEngine({
  adapter,
  tenantId: 'acme-corp',
  orgProvider,
  outOfOfficeProvider: {
    getDelegateFor: (userId, at) => hrSystem.coverFor(userId, at), // string | null
  },
});

// One-off hand-off of a request that is already waiting on someone
await engine.delegate(instance.id, {
  fromApprover: 'manager-bob',
  toApprover: 'manager-carol',
  reason: 'Away 2-13 November',
  until: new Date('2026-11-13'),
});

// manager-carol can now call engine.approve(instance.id, { approverId: 'manager-carol' })`);

const quotaCode = hl(`// Count approved leave in the same department that overlaps the request
async function overlappingLeave(departmentId: string, startDate: string, endDate: string) {
  const { items } = await engine.queryInstances(
    { documentType: 'leave-request', status: 'approved', data: { departmentId } },
    { limit: 500, offset: 0 }
  );
  // ISO dates compare correctly as strings
  return items.filter(
    (leave) => leave.data.startDate < endDate && leave.data.endDate > startDate
  ).length;
}

// Call before engine.submit()
const onLeave = await overlappingLeave(departmentId, startDate, endDate);
if (onLeave >= (await getTeamMaxConcurrent(departmentId))) {
  throw new Error(\`Team quota exceeded: \${onLeave} already on leave\`);
}`);

const emergencyCode = hl(`// Emergency leave: the manager level is skipped, HR is the only approver
const instance = await engine.submit({
  templateName: 'hr-leave',
  documentType: 'leave-request',
  documentId: 'leave-2026-0412',
  submittedBy: 'emp-0712',
  data: {
    leaveType: 'emergency',
    startDate: '2026-11-02',
    endDate: '2026-11-02',
    durationDays: 1,
  },
});
// instance.status === 'pending', waiting on level 3 (HR) only

await engine.approve(instance.id, { approverId: 'hr-erin' });
// instance.status === 'approved' — no manager round trip`);
---

<UseCaseLayout
  title="HR Leave Request Workflows"
  description="Type-aware leave approval chains with out-of-office cover when the approving manager is themselves on leave. Handles annual, extended, and emergency leave differently."
  tag="HR Systems"
>
  <section class="uc-hero">
    <div class="container">
      <div class="uc-tag-row">
        <span class="uc-tag" style="color:#7c3aed">HR Systems</span>
        <span class="uc-badge">hr-leave</span>
      </div>
      <h1 class="uc-title">HR Leave Request Workflows</h1>
      <p class="uc-sub">
        One template handles annual, sick, extended, and emergency leave — each with a different
        chain. Emergency leave skips the manager and goes straight to HR. Extended leave
        adds department head sign-off. An out-of-office provider covers manager absences.
      </p>
    </div>
  </section>

  <section class="chain-section">
    <div class="container">
      <div class="section-label-sm">Approval chains by leave type</div>
      <div class="chains-table">
        <div class="chain-row">
          <span class="chain-type">Annual / Sick (&ge;3d)</span>
          <div class="chain-flow">
            <div class="cf-node cf-always"><span class="cf-name">Manager</span></div>
            <span class="cf-arrow">→</span>
            <div class="cf-node cf-always"><span class="cf-name">HR Admin</span></div>
            <span class="cf-arrow">→</span>
            <div class="cf-node cf-done"><span class="cf-name">Approved</span></div>
          </div>
        </div>
        <div class="chain-row">
          <span class="chain-type">Extended (&gt;10 days)</span>
          <div class="chain-flow">
            <div class="cf-node cf-always"><span class="cf-name">Manager</span></div>
            <span class="cf-arrow">→</span>
            <div class="cf-node cf-cond"><span class="cf-name">Dept Head</span></div>
            <span class="cf-arrow">→</span>
            <div class="cf-node cf-always"><span class="cf-name">HR Admin</span></div>
            <span class="cf-arrow">→</span>
            <div class="cf-node cf-done"><span class="cf-name">Approved</span></div>
          </div>
        </div>
        <div class="chain-row">
          <span class="chain-type">Emergency</span>
          <div class="chain-flow">
            <div class="cf-node cf-always"><span class="cf-name">HR Admin</span></div>
            <span class="cf-arrow">→</span>
            <div class="cf-node cf-done"><span class="cf-name">Approved</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="code-section">
    <div class="container code-grid">
      <div class="code-meta">
        <span class="section-label-sm">Configuration</span>
        <h2 class="code-heading">One template, four leave types</h2>
        <p class="code-desc">
          The template has a manager level and an HR level; <code>conditions</code> read
          <code>leaveType</code> and <code>durationDays</code> from the request data to add
          the department head level or skip levels.
        </p>
        <ul class="code-bullets">
          <li>Short sick leave skips HR (under 3 days, manager only)</li>
          <li>Extended leave adds dept head between manager and HR</li>
          <li>Emergency leave skips the manager and waits on HR only</li>
          <li>All leave types maintain a full audit trail</li>
        </ul>
      </div>
      <div class="code-block">
        <div class="code-header">
          <span class="code-dots"><span></span><span></span><span></span></span>
          <span class="code-filename">hr-leave-template.ts</span>
        </div>
        <pre class="code-pre"><code><Fragment set:html={configCode} /></code></pre>
      </div>
    </div>
  </section>

  <section class="edges-section">
    <div class="container">
      <span class="section-label">Edge cases</span>
      <h2 class="section-title">What goes wrong in real HR systems.</h2>
      <p class="section-sub">These edge cases cause silent failures in hand-rolled approval scripts.</p>

      <div class="edges-grid">
        <div class="edge-card">
          <div class="edge-num">01</div>
          <h3 class="edge-title">Manager is on leave — out-of-office cover</h3>
          <p class="edge-desc">
            An employee submits leave, but their manager is also on leave.
            Without delegation, the request sits unreviewed until the manager returns —
            breaching SLA.
          </p>
          <div class="code-block">
            <div class="code-header">
              <span class="code-dots"><span></span><span></span><span></span></span>
              <span class="code-filename">delegate.ts</span>
            </div>
            <pre class="code-pre"><code><Fragment set:html={delegateCode} /></code></pre>
          </div>
          <p class="edge-note">
            The <code>outOfOfficeProvider</code> is asked for a stand-in whenever a level's
            approvers are resolved, so absence stays in your HR system. For a request already
            waiting, <code>engine.delegate()</code> hands it to someone else.
          </p>
        </div>

        <div class="edge-card">
          <div class="edge-num">02</div>
          <h3 class="edge-title">Team leave quota exceeded</h3>
          <p class="edge-desc">
            Half the engineering team requests the same week off. Without quota checking,
            all requests would be individually approved — leaving projects understaffed.
          </p>
          <div class="code-block">
            <div class="code-header">
              <span class="code-dots"><span></span><span></span><span></span></span>
              <span class="code-filename">quota-check.ts</span>
            </div>
            <pre class="code-pre"><code><Fragment set:html={quotaCode} /></code></pre>
          </div>
          <p class="edge-note">
            Query approved leave with <code>engine.queryInstances()</code> and block before
            calling <code>engine.submit()</code>. The quota itself is your rule, not the engine's.
          </p>
        </div>

        <div class="edge-card">
          <div class="edge-num">03</div>
          <h3 class="edge-title">Same-day emergency leave</h3>
          <p class="edge-desc">
            An employee has a family emergency at 8am and can't come in.
            They need approval confirmation immediately — not after a 24-hour review cycle.
          </p>
          <div class="code-block">
            <div class="code-header">
              <span class="code-dots"><span></span><span></span><span></span></span>
              <span class="code-filename">emergency.ts</span>
            </div>
            <pre class="code-pre"><code><Fragment set:html={emergencyCode} /></code></pre>
          </div>
          <p class="edge-note">
            The employee skips the manager level, so the request waits only on HR.
            There is no auto-approve: HR still makes the call.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="related-section">
    <div class="container">
      <h2 class="related-title">Related use cases</h2>
      <div class="related-grid">
        <a href="/use-cases/accounts-payable/" class="related-card">
          <span class="related-tag">Finance & ERP</span>
          <span class="related-name">Accounts Payable →</span>
        </a>
        <a href="/use-cases/expense-reports/" class="related-card">
          <span class="related-tag">Finance & HR</span>
          <span class="related-name">Expense Reports →</span>
        </a>
        <a href="/use-cases/multi-tenant-saas/" class="related-card">
          <span class="related-tag">SaaS Architecture</span>
          <span class="related-name">Multi-Tenant SaaS →</span>
        </a>
      </div>
    </div>
  </section>
</UseCaseLayout>

<style>
  .uc-hero { padding-block: 3.5rem 2.5rem; background: var(--bg); border-bottom: 1px solid var(--border-light); }
  .uc-tag-row { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.25rem; }
  .uc-tag { font-family: var(--font-mono); font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; }
  .uc-badge { font-family: var(--font-mono); font-size: 0.7rem; background: var(--bg-alt); border: 1px solid var(--border-light); color: var(--text-3); padding: 0.175rem 0.5rem; border-radius: 4px; }
  .uc-title { font-size: clamp(1.75rem, 3.5vw, 2.75rem); font-weight: 700; letter-spacing: -0.03em; margin-bottom: 1rem; }
  .uc-sub { font-size: 1.0625rem; color: var(--text-2); line-height: 1.65; max-width: 58ch; }

  .chain-section { padding-block: 2.5rem; background: var(--bg-alt); border-bottom: 1px solid var(--border-light); }
  .section-label-sm { font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); display: block; margin-bottom: 1.25rem; }

  .chains-table { display: flex; flex-direction: column; gap: 0.75rem; }
  .chain-row { display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap; }
  .chain-type { font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-3); min-width: 140px; }
  .chain-flow { display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap; }

  .cf-node { display: flex; flex-direction: column; align-items: center; gap: 0.2rem; padding: 0.5rem 0.75rem; border-radius: var(--radius); border: 1.5px solid var(--border); background: white; min-width: 76px; }
  .cf-always { border-color: var(--accent); background: var(--accent-bg); }
  .cf-cond   { border-color: var(--border-light); }
  .cf-done   { border-color: var(--accent); background: #d1fae5; }
  .cf-auto   { border-color: #7c3aed; background: #f5f3ff; }
  .cf-name { font-size: 0.75rem; font-weight: 600; color: var(--text); }
  .cf-badge { font-family: var(--font-mono); font-size: 0.5rem; font-weight: 700; letter-spacing: 0.05em; padding: 0.1rem 0.3rem; border-radius: 3px; text-transform: uppercase; }
  .cf-auto-badge { background: #f5f3ff; color: #7c3aed; }
  .cf-arrow { color: var(--border); font-size: 1.25rem; }

  .code-section { padding-block: 4rem; background: var(--bg); border-top: 1px solid var(--border-light); }
  .code-grid { display: grid; grid-template-columns: 280px 1fr; gap: 3rem; align-items: start; }
  .code-heading { font-size: 1.375rem; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 0.75rem; margin-top: 0.5rem; }
  .code-desc { font-size: 0.875rem; color: var(--text-2); line-height: 1.65; margin-bottom: 1rem; }
  .code-desc code, .edge-note code { font-family: var(--font-mono); font-size: 0.875em; background: var(--bg-alt); padding: 0.1em 0.3em; border-radius: 3px; color: var(--text); }
  .code-bullets { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .code-bullets li { font-size: 0.8125rem; color: var(--text-2); padding-left: 1.25rem; position: relative; line-height: 1.5; }
  .code-bullets li::before { content: '✓'; position: absolute; left: 0; color: var(--accent); font-size: 0.75rem; font-weight: 700; }

  .code-block { background: #1c1c1e; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid #3a3a3c; }
  .code-header { display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0.875rem; background: #2c2c2e; border-bottom: 1px solid #3a3a3c; }
  .code-dots { display: flex; gap: 0.3rem; }
  .code-dots span { width: 10px; height: 10px; border-radius: 50%; }
  .code-dots span:nth-child(1) { background: #ff5f57; }
  .code-dots span:nth-child(2) { background: #febc2e; }
  .code-dots span:nth-child(3) { background: #28c840; }
  .code-filename { font-family: var(--font-mono); font-size: 0.6875rem; color: #8e8e93; }
  .code-pre { padding: 1rem 1.125rem; overflow-x: auto; font-size: 0.75rem; line-height: 1.7; color: #e6edf3; scrollbar-width: thin; scrollbar-color: #3a3a3c transparent; }
  .code-pre :global(.k) { color: #ff7b72; }
  .code-pre :global(.s) { color: #a5d6ff; }
  .code-pre :global(.c) { color: #8b949e; font-style: italic; }
  .code-pre :global(.n) { color: #79c0ff; }

  .edges-section { padding-block: 5rem; background: var(--bg-alt); border-top: 1px solid var(--border-light); }
  .section-sub { margin-bottom: 3rem; }
  .edges-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem; }
  .edge-card { background: white; border: 1px solid var(--border-light); border-radius: var(--radius-lg); padding: 1.5rem; display: flex; flex-direction: column; gap: 0.875rem; box-shadow: var(--shadow-xs); }
  .edge-num { font-family: var(--font-mono); font-size: 0.7rem; font-weight: 700; color: var(--accent); letter-spacing: 0.1em; }
  .edge-title { font-size: 1rem; font-weight: 700; letter-spacing: -0.01em; color: var(--text); }
  .edge-desc { font-size: 0.8125rem; color: var(--text-2); line-height: 1.6; }
  .edge-note { font-size: 0.7875rem; color: var(--text-3); line-height: 1.55; padding-top: 0.5rem; border-top: 1px solid var(--border-light); }

  .related-section { padding-block: 3.5rem; background: var(--bg); border-top: 1px solid var(--border-light); }
  .related-title { font-size: 1.125rem; font-weight: 700; margin-bottom: 1.25rem; letter-spacing: -0.01em; }
  .related-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 0.75rem; }
  .related-card { display: flex; flex-direction: column; gap: 0.375rem; padding: 1rem 1.25rem; background: var(--bg-alt); border: 1px solid var(--border-light); border-radius: var(--radius); text-decoration: none; transition: background 0.15s; }
  .related-card:hover { background: white; text-decoration: none; }
  .related-tag { font-family: var(--font-mono); font-size: 0.6rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: var(--text-3); }
  .related-name { font-size: 0.9375rem; font-weight: 600; color: var(--accent); }

  @media (max-width: 860px) {
    .code-grid { grid-template-columns: minmax(0, 1fr); }
    .edges-grid { grid-template-columns: minmax(0, 1fr); }
    .code-grid > *, .edge-card { min-width: 0; }
    .related-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
