---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import PainPoints from '../components/PainPoints.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Features from '../components/Features.astro';
import QuickStart from '../components/QuickStart.astro';
import Adapters from '../components/Adapters.astro';
import Plugins from '../components/Plugins.astro';
import Comparison from '../components/Comparison.astro';
import UseCasesSection from '../components/UseCasesSection.astro';
import BlogSection from '../components/BlogSection.astro';
import InstallCTA from '../components/InstallCTA.astro';
import Footer from '../components/Footer.astro';

let weeklyDownloads = '—';
try {
  const res = await fetch(
    'https://api.npmjs.org/downloads/point/last-week/hierarchical-approval'
  );
  if (res.ok) {
    const data = await res.json();
    if (typeof data.downloads === 'number') {
      weeklyDownloads = data.downloads.toLocaleString('en-US');
    }
  }
} catch {
  // build continues with the placeholder
}
---

<Layout weeklyDownloads={weeklyDownloads}>
  <Nav />
  <main id="main-content">
    <Hero weeklyDownloads={weeklyDownloads} />
    <PainPoints />
    <HowItWorks />
    <Features />
    <QuickStart />
    <Comparison />
    <Adapters />
    <Plugins />
    <UseCasesSection />
    <BlogSection />
    <InstallCTA />
  </main>
  <Footer />
</Layout>
