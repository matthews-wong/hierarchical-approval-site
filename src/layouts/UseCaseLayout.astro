---
import Layout from './Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import InstallCTA from '../components/InstallCTA.astro';

interface Props {
  title: string;
  description: string;
  tag: string;
  tagColor?: string;
  prev?: { title: string; href: string };
  next?: { title: string; href: string };
}

const { title, description, tag, tagColor = '#1a7a45', prev, next } = Astro.props;
const pageTitle = `${title} — hierarchical-approval`;
---

<Layout title={pageTitle} description={description} weeklyDownloads="—">
  <Nav />
  <main id="main-content">
    <div class="breadcrumb-bar">
      <div class="container breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/use-cases/">Use Cases</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{title}</span>
      </div>
    </div>

    <slot />

    <InstallCTA />
  </main>
  <Footer />
</Layout>

<style>
  .breadcrumb-bar {
    border-bottom: 1px solid var(--border-light);
    background: var(--bg-alt);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-block: 0.875rem;
    font-size: 0.8125rem;
  }

  .breadcrumb a {
    color: var(--text-2);
    text-decoration: none;
    transition: color 0.15s;
  }

  .breadcrumb a:hover { color: var(--text); }

  .breadcrumb span[aria-hidden] { color: var(--text-3); }

  .breadcrumb span[aria-current] { color: var(--text); font-weight: 500; }
</style>

<style is:global>
  /*
   * Global mobile overrides for all use case pages.
   * !important is intentional — beats Astro's scoped attribute selectors.
   */

  /* ── Grids: auto-fit so columns collapse when space is tight ── */
  .edges-grid {
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)) !important;
  }

  .related-grid {
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)) !important;
  }

  /* ── Code blocks: never wider than their container ── */
  .code-block {
    max-width: 100% !important;
    width: 100% !important;
    min-width: 0 !important;
    box-sizing: border-box !important;
  }

  /* ── Code pre: scrollable on touch, no page-scroll bleed-through ── */
  .code-pre {
    -webkit-overflow-scrolling: touch !important;
    overscroll-behavior-x: contain !important;
    overflow-x: auto !important;
  }
  .code-pre::-webkit-scrollbar { height: 3px !important; }
  .code-pre::-webkit-scrollbar-track { background: transparent !important; }
  .code-pre::-webkit-scrollbar-thumb { background: #3a3a3c !important; border-radius: 2px !important; }

  /* ── Chain flow: always scrollable, never wrapping ── */
  .chain-section {
    overflow-x: hidden;
  }
  .chain-flow {
    flex-wrap: nowrap !important;
    overflow-x: auto !important;
    -webkit-overflow-scrolling: touch !important;
    scrollbar-width: none !important;
    /* Ensure the scroll container is wide enough to hold all nodes */
    min-width: 0 !important;
  }
  .chain-flow::-webkit-scrollbar { display: none; }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    /* Code sections: single column */
    .code-grid,
    .code-grid.reverse {
      grid-template-columns: 1fr !important;
      gap: 1.5rem !important;
    }
    .code-grid.reverse .code-meta { order: 0 !important; }
    /* All direct children of code-grid take full grid width */
    .code-grid > *,
    .code-grid.reverse > * {
      width: 100% !important;
      max-width: 100% !important;
      min-width: 0 !important;
    }
    /* Cap tall code blocks in step sections — the block itself scrolls vertically */
    .code-grid .code-block,
    .code-grid.reverse .code-block {
      max-height: 280px !important;
      overflow-y: auto !important;
      overflow-x: hidden !important;
    }

    /* Edges grid: single column on phones */
    .edges-grid { grid-template-columns: 1fr !important; }

    /* Related grid: two columns on tablet, then one */
    .related-grid { grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)) !important; }

    /* Edge cards: cap code block height so cards stay phone-sized */
    .edge-card { align-items: stretch !important; }
    .edge-card .code-block {
      align-self: stretch !important;
      max-height: 200px !important;
      overflow-y: auto !important;
      overflow-x: hidden !important;
    }

    /* Scrollable chain flow gets padding for breathing room */
    .chain-flow { padding-bottom: 0.75rem !important; gap: 0.375rem !important; }

    /* Scrollable tables */
    .chain-table-wrap,
    .table-wrap { overflow-x: auto !important; -webkit-overflow-scrolling: touch !important; }
  }

  @media (max-width: 480px) {
    .edges-grid { grid-template-columns: 1fr !important; }
    .related-grid { grid-template-columns: 1fr !important; }

    /* Compact code blocks on small phones — maximize code visibility */
    .code-pre {
      padding: 0.75rem 0.875rem !important;
      font-size: 0.7rem !important;
    }
    .edge-card {
      padding: 1.125rem !important;
      gap: 0.625rem !important;
    }
    /* Use case hero */
    .uc-hero { padding-block: 2.5rem !important; }
    .uc-title { font-size: 1.75rem !important; }
    .uc-sub { font-size: 0.9375rem !important; }
  }
</style>
