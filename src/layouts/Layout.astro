---
import pkg from '../../package.json';

interface Props {
  title?: string;
  description?: string;
  weeklyDownloads?: string;
}

const libraryVersion = pkg.devDependencies['hierarchical-approval'];

const {
  title = 'hierarchical-approval — TypeScript Approval Workflow Engine for ERP',
  description = 'TypeScript-first multi-level approval workflow engine for ERP systems. Optimistic locking, idempotency, audit trail, SLA tracking, conditional chains — without BPMN or external infrastructure.',
  weeklyDownloads = '—',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const softwareApplicationSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'hierarchical-approval',
  description: 'TypeScript-first multi-level approval workflow engine for ERP systems.',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Node.js',
  programmingLanguage: 'TypeScript',
  softwareVersion: libraryVersion,
  license: 'https://opensource.org/licenses/MIT',
  url: 'https://hierarchical-approval.matthewswong.com',
  downloadUrl: 'https://www.npmjs.com/package/hierarchical-approval',
  author: {
    '@type': 'Person',
    name: 'Matthews Wong',
    url: 'https://www.matthewswong.com',
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is hierarchical-approval?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'hierarchical-approval is a TypeScript-first npm library that provides a complete approval workflow engine for ERP and enterprise systems. It handles multi-level sequential and parallel approval chains, conditional routing, optimistic locking, idempotency, immutable audit trails, SLA tracking, escalation, and delegation — without requiring BPMN, external orchestrators, or hand-rolled logic.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does hierarchical-approval support PostgreSQL?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. The library ships a production-ready PostgresAdapter as a peer dependency. Call adapter.migrate() once to set up the schema. It also includes a MemoryAdapter for development and zero-I/O testing.',
      },
    },
    {
      '@type': 'Question',
      name: 'How does optimistic locking work in hierarchical-approval?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Every ApprovalInstance carries a version counter. The storage adapter\'s updateInstance() method checks the stored version against the expected version before writing. If they differ (meaning another process modified the instance concurrently), it throws an ApprovalConflictError. The engine retries automatically up to maxAttempts times (default 3) with linear backoff (baseDelayMs times the attempt number) plus random jitter, which is on by default.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I use hierarchical-approval without a real database in tests?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. The ApprovalTestKit utility creates a pre-wired engine with MemoryAdapter and ManualClock. ManualClock.advanceDays(n) lets you test SLA breaches and escalation scheduling without real timers. ApprovalTestKit.fullyApprove() drives an instance through all levels in one call.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does hierarchical-approval ship built-in audit, metrics, and notification plug-ins?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. As of 0.6, the library ships seven production-grade plug-ins on dedicated import subpaths, each with zero runtime dependencies and fully tree-shakeable. plugins/audit provides a tamper-evident SHA-256 hash-chained audit adapter with a verify() method (detecting edits, deletions, reordering, and tail truncation) plus PII redaction. plugins/metrics provides a Prometheus scrape adapter and an in-memory snapshot adapter with p50/p95. plugins/resilience provides an RBAC default-deny authorization policy, token-bucket rate limiting, and structured logging middleware. plugins/notify provides a reliable outbox notification adapter with retry, exponential backoff, and a dead-letter queue for at-least-once delivery. plugins/tracing provides OpenTelemetry-shaped spans per approval operation without taking an OpenTelemetry dependency. plugins/webhook delivers lifecycle events over HTTP with HMAC-SHA256 request signing, jittered retry and Retry-After handling. plugins/scheduler lets escalation and SLA deadlines run on your own job runner (BullMQ, Temporal, cron) instead of an in-process timer.',
      },
    },
    {
      '@type': 'Question',
      name: 'What approval modes does hierarchical-approval support?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Each approval level has a mode field: "any" (one approver is sufficient), "all" (every listed approver must act), or "majority" (more than half must approve). Modes are configured per-level in the template.',
      },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="hierarchical-approval" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />


    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(softwareApplicationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>
  <body>
    <slot />
    <script>
      // Scroll-reveal: fade/slide sections in as they enter the viewport.
      // JS-only (no-JS users see everything), above-the-fold content is never
      // hidden, and prefers-reduced-motion opts out entirely.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce && 'IntersectionObserver' in window) {
        const SELECTOR = [
          '.section-label', '.section-title', '.section-sub',
          '.feat-card', '.adapter-card', '.plugin-card', '.plugin-foot',
          '.compare-row', '.usecase-card', '.blog-card', '.pain-card', '.step',
        ].join(',');

        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              (e.target as HTMLElement).classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        }, { threshold: 0.08, rootMargin: '0px 0px -8% 0px' });

        const fold = window.innerHeight * 0.92;
        document.querySelectorAll<HTMLElement>(SELECTOR).forEach((el) => {
          if (el.getBoundingClientRect().top < fold) return; // already visible — don't animate
          // light stagger by position among matched siblings
          const sibs = el.parentElement
            ? Array.from(el.parentElement.children).filter((c) => (c as HTMLElement).matches(SELECTOR))
            : [el];
          const i = Math.min(sibs.indexOf(el), 5);
          el.style.transitionDelay = `${i * 55}ms`;
          el.classList.add('pre-reveal');
          io.observe(el);
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #ffffff;
    --bg-alt: #f5f5f7;
    --surface: #ffffff;
    --border: #d2d2d7;
    --border-light: #e8e8ed;
    --text: #1d1d1f;
    --text-2: #6e6e73;
    --text-3: #aeaeb2;
    --accent: #1a7a45;
    --accent-bg: #f0f9f4;
    --accent-mid: #d0eddb;
    --amber: #b45309;
    --amber-bg: #fef9ee;
    --code-bg: #f5f5f7;
    --shadow-xs: 0 1px 4px rgba(0,0,0,0.06);
    --shadow-sm: 0 2px 10px rgba(0,0,0,0.07);
    --shadow: 0 4px 20px rgba(0,0,0,0.08);
    --font: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --font-mono: ui-monospace, 'SF Mono', 'JetBrains Mono', monospace;
    --radius: 10px;
    --radius-lg: 16px;
    --max-w: 1080px;
    --section-gap: 7rem;
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font);
    font-size: 17px;
    line-height: 1.6;
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
  }

  body {
    min-height: 100vh;
    overflow-x: hidden;
  }

  h1, h2, h3, h4 {
    font-family: var(--font);
    line-height: 1.1;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.02em;
  }

  a {
    color: var(--accent);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  code, pre {
    font-family: var(--font-mono);
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 3px;
  }

  .container {
    max-width: var(--max-w);
    margin-inline: auto;
    padding-inline: 2rem;
  }

  .section {
    padding-block: var(--section-gap);
  }

  .section-label {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1rem;
    display: block;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    margin-bottom: 1.25rem;
    letter-spacing: -0.025em;
  }

  .section-sub {
    font-size: 1.0625rem;
    color: var(--text-2);
    max-width: 52ch;
    line-height: 1.7;
  }

  /* Ensure sticky nav (52px) doesn't cover anchor targets */
  [id] { scroll-margin-top: 64px; }

  /* ── Global: code scroll containers are touch-friendly on iOS ── */
  .code-scroll-wrap,
  pre[class],
  .code-pre {
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
  }

  @media (max-width: 640px) {
    :root { --section-gap: 4rem; }
    .container { padding-inline: 1.25rem; }
    .section-title { font-size: 1.875rem; }
    .section-sub { font-size: 1rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }

  /* ── Scroll-reveal (applied by JS only; see body script) ── */
  @media (prefers-reduced-motion: no-preference) {
    .pre-reveal {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                  transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
      will-change: opacity, transform;
    }
    .pre-reveal.is-visible {
      opacity: 1;
      transform: none;
    }
  }
</style>
